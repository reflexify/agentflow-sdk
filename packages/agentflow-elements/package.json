{
  "name": "@reflexify/agentflow-elements",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/agentflow-elements.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "import": "./dist/kit.js"
    },
    "./escape": {
      "types": "./dist/kit/escape.d.ts",
      "import": "./dist/escape.js"
    },
    "./kit.css": "./dist/kit.css",
    "./jsx": {
      "types": "./jsx.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "jsx.d.ts",
    "DESIGN.md"
  ],
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.build.json --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/kit/kit.css','dist/kit.css')\"",
    "gallery": "vite",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.24.2",
    "@reflexify/agentflow-sdk": "github:reflexify/agentflow-sdk#sdk-v0.11.0&path:packages/agentflow-sdk",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "marked": "^17.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
