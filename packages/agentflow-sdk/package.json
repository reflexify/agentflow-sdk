{
  "name": "@reflexify/agentflow-sdk",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "workerd": "./dist/server/index.js",
      "worker": "./dist/server/index.js",
      "edge-light": "./dist/server/index.js",
      "browser": "./dist/server/refuse-browser.js",
      "import": "./dist/server/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "openapi-typescript ../../../openapi.json --empty-objects-unknown --output src/generated/public.ts && node scripts/gen-operations.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.testing.json"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "openapi-fetch": "^0.17.0",
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@types/node": "^26.6.2",
    "hono": "^4.13.9",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
