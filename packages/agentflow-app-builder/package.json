{
  "name": "@reflexify/agentflow-app-builder",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    }
  },
  "bin": {
    "agentflow-app": "./bin/agentflow-app.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && node scripts/copy-starter.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
