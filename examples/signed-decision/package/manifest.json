{
  "formatVersion": 1,
  "id": "acme/signed-decision",
  "version": "0.1.0",
  "name": "Signed decisions",
  "summary": "Record a decision, have its initiator sign a letter for it, and keep the signed file on the record.",
  "publisher": {
    "name": "Acme",
    "contact": "apps@acme.example",
    "support": "https://acme.example/support"
  },
  "license": "Proprietary",
  "dataHandling": {
    "purpose": "Recording decisions and keeping the signed letter for each",
    "storage": "In the organization's AgentFlow",
    "retention": "As long as the organization keeps its decisions",
    "privacy": "https://acme.example/privacy",
    "recipients": []
  },
  "changelog": "First release: the Decision entity, a Sign action and the Sign a decision workflow.",
  "contentLocale": "en",
  "minPlatformVersion": "2026.11",
  "requires": {
    "platformCapabilities": [],
    "entities": [],
    "permissions": [
      {
        "group": "@param:app_users",
        "permissions": [
          "entity.read",
          "entity.list",
          "entity.write"
        ]
      }
    ]
  },
  "exports": [],
  "parameters": [
    {
      "key": "app_users",
      "type": "group_ref",
      "required": true,
      "label": "Decision users",
      "help": "Everyone who records and signs decisions. Give its members a role with entity.read, entity.list and entity.write: a role does not come from a group."
    }
  ],
  "audience": "@param:app_users",
  "features": {},
  "objects": [
    {
      "key": "entity:decision",
      "kind": "entity"
    },
    {
      "key": "entity_field:decision/title",
      "kind": "entity_field"
    },
    {
      "key": "entity_field:decision/status",
      "kind": "entity_field"
    },
    {
      "key": "entity_field:decision/signed_file",
      "kind": "entity_field"
    },
    {
      "key": "entity_view:decision/all",
      "kind": "entity_view"
    },
    {
      "key": "form:decision",
      "kind": "form"
    },
    {
      "key": "document_template:decision_letter",
      "kind": "document_template"
    },
    {
      "key": "workflow:sign_decision",
      "kind": "workflow"
    },
    {
      "key": "entity_action:decision/sign",
      "kind": "entity_action"
    }
  ],
  "grants": [
    {
      "key": "decision_app_users",
      "to": "@param:app_users",
      "entity": "@obj:entity:decision",
      "operations": {
        "read": "organization",
        "list": "organization",
        "create": "organization",
        "update": "organization"
      }
    },
    {
      "key": "start_sign_decision",
      "to": "@param:app_users",
      "workflow": "@obj:workflow:sign_decision"
    }
  ],
  "ceiling": {
    "narrow": {}
  },
  "egress": [],
  "ui": {
    "kind": "module",
    "entry": "ui/index.js",
    "contract": 3
  },
  "tests": []
}
