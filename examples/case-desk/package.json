{
  "name": "case-desk",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "setup-keys": "tsx scripts/setup.ts",
    "check-setup": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "dev": "vite",
    "build": "agentflow-app build",
    "check": "agentflow-app build --check",
    "seal": "agentflow-app seal",
    "build:site": "vite build",
    "start": "pnpm build:site && NODE_ENV=production tsx --env-file-if-exists=.env server/main.ts",
    "demo": "vite --config vite.module.config.ts --open /module.html",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run && agentflow-app build --check && agentflow-app types --check"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@reflexify/agentflow-elements": "github:reflexify/agentflow-sdk#sdk-v0.4.0&path:packages/agentflow-elements",
    "@reflexify/agentflow-sdk": "github:reflexify/agentflow-sdk#sdk-v0.4.0&path:packages/agentflow-sdk",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@reflexify/agentflow-app-builder": "github:reflexify/agentflow-sdk#sdk-v0.4.0&path:packages/agentflow-app-builder",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
