# Case desk: where the browser reaches this app.
CASE_DESK_ORIGIN=http://localhost:5173
# Generated by `pnpm setup-keys`; never commit the real value.
CASE_DESK_SESSION_KEY=
# The identity provider AgentFlow trusts (AgentFlow's OIDC_ISSUER).
AGENTFLOW_ISSUER=
AGENTFLOW_CLIENT_ID=case-desk-dev
AGENTFLOW_PRIVATE_KEY_FILE=keys/private.pem
# Written by `pnpm setup-keys`.
AGENTFLOW_PRIVATE_KEY_ID=
# AgentFlow's public API.
AGENTFLOW_API_BASE_URL=http://localhost:8080/api/v1
# AgentFlow's REST resource. Blank means {AGENTFLOW_API_BASE_URL}/rest; set it only when the
# API_RESOURCE_URI AgentFlow runs with differs from that.
AGENTFLOW_RESOURCE=
# Optional: the org to sign in to when a person belongs to several.
AGENTFLOW_ORG_HINT=
# The demo data (see RUNBOOK.md, step 4).
CASE_DESK_ENTITY_ID=
CASE_DESK_WORKFLOW_ID=
