{
  "key": "projects_overview", "name": "Projects overview",
  "description": "Open, blocked and completed tasks across the projects you can see.",
  "tiles": [
    { "kind": "number", "id": "0190f8f4-0000-7000-8000-0000000000a1", "label": "Open tasks",
      "query": { "entity_id": "${entity:task}", "measures": [ { "id": "0190f8f4-0000-7000-8000-0000000000b1", "fn": "count", "primary": true } ],
        "filter": { "field_filters": [ { "field": "status", "op": "in", "value": ["todo", "doing"] }, { "field": "frozen", "op": "ne", "value": true } ] } },
      "position": { "row": 0, "col": 0, "w": 6, "h": 5 } },
    { "kind": "number", "id": "0190f8f4-0000-7000-8000-0000000000a2", "label": "Blocked",
      "query": { "entity_id": "${entity:task}", "measures": [ { "id": "0190f8f4-0000-7000-8000-0000000000b2", "fn": "count", "primary": true } ],
        "filter": { "field_filters": [ { "field": "status", "op": "eq", "value": "doing" }, { "field": "blocked", "op": "eq", "value": true }, { "field": "frozen", "op": "ne", "value": true } ] } },
      "position": { "row": 0, "col": 6, "w": 6, "h": 5 } },
    { "kind": "number", "id": "0190f8f4-0000-7000-8000-0000000000a3", "label": "Completed this month",
      "query": { "entity_id": "${entity:task}", "measures": [ { "id": "0190f8f4-0000-7000-8000-0000000000b3", "fn": "count", "primary": true } ],
        "filter": { "field_filters": [ { "field": "frozen", "op": "ne", "value": true } ], "relative_dates": [ { "field": "completed_at", "window": "this_month" } ] } },
      "position": { "row": 0, "col": 12, "w": 6, "h": 5 } },
    { "kind": "number", "id": "0190f8f4-0000-7000-8000-0000000000a4", "label": "% complete",
      "query": { "entity_id": "${entity:task}", "measures": [ { "id": "0190f8f4-0000-7000-8000-0000000000b4", "fn": "ratio", "primary": true,
          "ratio": { "of": "completed_at", "per": "title", "using": "count_filled" } } ],
        "filter": { "field_filters": [ { "field": "status", "op": "ne", "value": "cancelled" }, { "field": "frozen", "op": "ne", "value": true } ] } },
      "position": { "row": 0, "col": 18, "w": 6, "h": 5 } },
    { "kind": "chart", "id": "0190f8f4-0000-7000-8000-0000000000a5", "label": "Tasks by project and status", "chart": "bar",
      "query": { "entity_id": "${entity:task}", "measures": [ { "id": "0190f8f4-0000-7000-8000-0000000000b5", "fn": "count", "primary": true } ],
        "filter": { "field_filters": [ { "field": "status", "op": "ne", "value": "cancelled" }, { "field": "frozen", "op": "ne", "value": true } ] } },
      "split_by": { "field": "project" }, "stack_by": { "field": "status" },
      "position": { "row": 5, "col": 0, "w": 12, "h": 10 } },
    { "kind": "chart", "id": "0190f8f4-0000-7000-8000-0000000000a6", "label": "Open tasks by priority", "chart": "bar",
      "query": { "entity_id": "${entity:task}", "measures": [ { "id": "0190f8f4-0000-7000-8000-0000000000b6", "fn": "count", "primary": true } ],
        "filter": { "field_filters": [ { "field": "status", "op": "in", "value": ["todo", "doing"] }, { "field": "frozen", "op": "ne", "value": true } ] } },
      "split_by": { "field": "priority" },
      "position": { "row": 5, "col": 12, "w": 12, "h": 10 } }
  ]
}
