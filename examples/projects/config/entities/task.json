{
  "key": "task", "name": "Task", "description": "A task in a project.", "icon": "square-check", "accent": "sky",
  "fields": [
    { "key": "title", "label": "Title", "type": "text", "required": true, "searchable": true },
    { "key": "project", "label": "Project", "type": "reference", "required": true, "target_entity_id": "${entity:project}",
      "on_target_delete": "restrict", "inverse_key": "tasks", "inverse_label": "Tasks" },
    { "key": "section", "label": "Section", "type": "reference", "target_entity_id": "${entity:section}",
      "on_target_delete": "clear", "inverse_key": "tasks", "inverse_label": "Tasks" },
    { "key": "position", "label": "Position", "type": "number" },
    { "key": "description", "label": "Description", "type": "text", "format": "richtext" },
    { "key": "status", "label": "Status", "type": "enum", "facetable": true,
      "enum_values": [ { "value": "todo", "label": "To do" }, { "value": "doing", "label": "In progress", "color": "sky" },
                       { "value": "done", "label": "Done", "color": "emerald" }, { "value": "cancelled", "label": "Cancelled", "color": "gray" } ],
      "default": { "kind": "literal", "value": "todo" } },
    { "key": "blocked", "label": "Blocked", "type": "boolean", "default": { "kind": "literal", "value": false } },
    { "key": "label", "label": "Label", "type": "reference", "target_entity_id": "${entity:task_label}", "on_target_delete": "clear",
      "inverse_key": "tasks", "inverse_label": "Tasks" },
    { "key": "collaborators", "label": "Collaborators", "type": "reference_list", "sortable": false, "target_entity_id": "ffffffff-0000-0000-0000-000000000001" },
    { "key": "priority", "label": "Priority", "type": "enum", "facetable": true,
      "enum_values": [ { "value": "low", "label": "Low" }, { "value": "medium", "label": "Medium" },
                       { "value": "high", "label": "High", "color": "amber" }, { "value": "urgent", "label": "Urgent", "color": "rose" } ],
      "default": { "kind": "literal", "value": "medium" } },
    { "key": "due", "label": "Due", "type": "date" },
    { "key": "checklist", "label": "Checklist", "type": "list", "sortable": false,
      "item_fields": [ { "key": "text", "label": "Text", "type": "text", "required": true },
                       { "key": "done", "label": "Done", "type": "boolean", "required": false, "history": false } ],
      "format_options": { "display": "checklist", "done_field": "done" }, "constraints": { "max_items": 20 } },
    { "key": "attachments", "label": "Attachments", "type": "file", "format_options": { "max_files": 20 } },
    { "key": "checklist_done", "label": "Checklist done", "type": "formula", "formula_expression": "count_if(checklist, \"done\")", "formula_result_type": "number" },
    { "key": "checklist_total", "label": "Checklist items", "type": "formula", "formula_expression": "count(checklist)", "formula_result_type": "number" },
    { "key": "show_checklist_on_card", "label": "Show the checklist on the card", "type": "boolean", "default": { "kind": "literal", "value": false } },
    { "key": "origin", "label": "Origin", "type": "enum", "enum_values": ["manual", "assistant", "document", "workflow"],
      "default": { "kind": "literal", "value": "manual" } },
    { "key": "origin_ref", "label": "Origin reference", "type": "text" },
    { "key": "completed_at", "label": "Completed at", "type": "datetime" },
    { "key": "frozen", "label": "Frozen", "type": "boolean", "default": { "kind": "literal", "value": false } }
  ],
  "natural_key": [], "display_field": "title",
  "views": [
    { "key": "all", "name": "Tasks", "columns": ["title", "project", "section", "status", "priority", "due", "claimed_by"],
      "config": { "presets": [ { "id": "0190f8f4-0000-7000-8000-0000000000f1", "label": "Mine",
        "rules": [ { "field": "claimed_by", "op": "eq", "value": { "$bind": "viewer.id" } } ] } ] } },
    { "key": "open", "name": "Open tasks", "columns": ["title", "project", "status", "priority", "due", "claimed_by"],
      "filters": [ { "field": "status", "op": "in", "value": ["todo", "doing"] } ] }
  ],
  "create_form": { "name": "Task", "schema": { "type": "object", "properties": {
    "title": { "type": "string", "x-entityField": "title" },
    "project": { "type": "string", "format": "entity", "x-entity": "project", "x-entityField": "project" },
    "section": { "type": "string", "format": "entity", "x-entity": "section", "x-entityField": "section" },
    "priority": { "type": "string", "x-entityField": "priority" },
    "due": { "type": "string", "format": "date", "x-entityField": "due" },
    "description": { "type": "string", "x-entityField": "description" } } } },
  "rules": [
    { "key": "content_by_owner_or_manager", "message": "Only the owner or a project manager changes this", "field": "title",
      "condition": { "join": "and", "leaves": [
        { "kind": "write", "write": { "op": "is_update" } },
        { "kind": "write", "write": { "op": "changed_any", "fields": ["title", "description", "due", "priority", "collaborators"] } },
        { "kind": "write", "write": { "op": "actor", "negate": true, "test": { "kind": "is_holder" } } },
        { "kind": "write", "write": { "op": "actor", "negate": true, "test": { "kind": "in_parent_field", "field": "project", "parent_field": "managers" } } } ] } },
    { "key": "board_by_participants", "message": "Only the owner, a collaborator or a project manager changes this", "field": "label",
      "condition": { "join": "and", "leaves": [
        { "kind": "write", "write": { "op": "is_update" } },
        { "kind": "write", "write": { "op": "changed_any", "fields": ["label", "blocked", "section", "position", "checklist", "attachments"] } },
        { "kind": "write", "write": { "op": "actor", "negate": true, "test": { "kind": "is_holder" } } },
        { "kind": "write", "write": { "op": "actor", "negate": true, "test": { "kind": "in_field", "field": "collaborators" } } },
        { "kind": "write", "write": { "op": "actor", "negate": true, "test": { "kind": "in_parent_field", "field": "project", "parent_field": "managers" } } } ] } },
    { "key": "blocked_only_while_doing", "message": "Only a task in progress can be blocked", "field": "blocked",
      "condition": { "join": "and", "leaves": [
        { "kind": "field", "rule": { "field": "blocked", "op": "eq", "value": true } },
        { "kind": "field", "rule": { "field": "status", "op": "ne", "value": "doing" } } ] } },
    { "key": "label_matches_status", "message": "The label belongs to another status", "field": "label",
      "condition": { "join": "and", "leaves": [
        { "kind": "field", "rule": { "field": "label.base_status", "op": "ne", "value": { "$field": "status" } } } ] } },
    { "key": "section_in_project", "message": "The section belongs to another project", "field": "section",
      "condition": { "join": "and", "leaves": [
        { "kind": "field", "rule": { "field": "section.project", "op": "ne", "value": { "$field": "project" } } } ] } },
    { "key": "frozen_is_frozen", "message": "This task is frozen because its project is closed",
      "condition": { "join": "and", "leaves": [
        { "kind": "write", "write": { "op": "is_update" } },
        { "kind": "write", "write": { "op": "was", "rule": { "field": "frozen", "op": "eq", "value": true } } },
        { "kind": "write", "write": { "op": "actor", "negate": true, "test": { "kind": "in_group", "group_id": "${param:automation_group}" } } } ] } }
,
    { "key": "project_is_fixed", "message": "A record cannot move to another project", "field": "project",
      "condition": { "join": "and", "leaves": [
        { "kind": "write", "write": { "op": "is_update" } },
        { "kind": "write", "write": { "op": "changed", "field": "project" } } ] } },
    { "key": "no_task_in_closed_project", "message": "A closed project takes no new tasks", "field": "project",
      "condition": { "join": "and", "leaves": [
        { "kind": "write", "write": { "op": "is_new" } },
        { "kind": "field", "rule": { "field": "project.status", "op": "eq", "value": "closed" } } ] } }
  ],
  "stage_model": { "status_field": "status", "initial_statuses": ["todo"], "transitions": [
    { "from": "todo", "to": "doing", "required_fields": [], "movers": [ { "kind": "is_holder" }, { "kind": "in_field", "field": "collaborators" }, { "kind": "in_parent_field", "field": "project", "parent_field": "managers" } ] },
    { "from": "doing", "to": "todo", "required_fields": [], "movers": [ { "kind": "is_holder" }, { "kind": "in_field", "field": "collaborators" }, { "kind": "in_parent_field", "field": "project", "parent_field": "managers" } ] },
    { "from": "doing", "to": "done", "required_fields": [], "movers": [ { "kind": "is_holder" } ] },
    { "from": "todo", "to": "done", "required_fields": [], "movers": [ { "kind": "is_holder" } ] },
    { "from": "done", "to": "doing", "required_fields": [], "movers": [ { "kind": "in_parent_field", "field": "project", "parent_field": "managers" } ] },
    { "from": "todo", "to": "cancelled", "required_fields": [], "movers": [ { "kind": "is_holder" }, { "kind": "in_parent_field", "field": "project", "parent_field": "managers" } ] },
    { "from": "doing", "to": "cancelled", "required_fields": [], "movers": [ { "kind": "is_holder" }, { "kind": "in_parent_field", "field": "project", "parent_field": "managers" } ] },
    { "from": "cancelled", "to": "todo", "required_fields": [], "movers": [ { "kind": "in_parent_field", "field": "project", "parent_field": "managers" } ] } ] },
  "work": {
    "lifecycle": { "status_field": "status", "categories": { "todo": "active", "doing": "active", "done": "done", "cancelled": "cancelled" } },
    "assignable": { "claim": "readers", "rules": [ { "on": "start", "assign": [ { "kind": "dynamic", "source": { "type": "creator" } } ] } ] },
    "work_surface": { "priority": { "field": "priority", "values": { "low": "low", "medium": "normal", "high": "high", "urgent": "urgent" } } }
  },
  "access": { "mode": "restricted", "grants": [
    { "principal": { "kind": "everyone" }, "operations": [
      { "operation": "read", "record_scopes": [ { "kind": "parent_field", "field": "project", "parent_field": "managers" }, { "kind": "parent_field", "field": "project", "parent_field": "members" }, { "kind": "field", "field": "collaborators" } ] },
      { "operation": "list", "record_scopes": [ { "kind": "parent_field", "field": "project", "parent_field": "managers" }, { "kind": "parent_field", "field": "project", "parent_field": "members" }, { "kind": "field", "field": "collaborators" } ] },
      { "operation": "create", "record_scopes": [ { "kind": "parent_field", "field": "project", "parent_field": "managers" }, { "kind": "parent_field", "field": "project", "parent_field": "members" } ] },
      { "operation": "update", "record_scopes": [ { "kind": "parent_field", "field": "project", "parent_field": "managers" }, { "kind": "parent_field", "field": "project", "parent_field": "members" }, { "kind": "field", "field": "collaborators" } ] },
      { "operation": "assign", "record_scopes": [ { "kind": "parent_field", "field": "project", "parent_field": "managers" } ] },
      { "operation": "delete", "record_scopes": [ { "kind": "parent_field", "field": "project", "parent_field": "managers" } ] } ] },
    { "principal": { "kind": "group", "id": "${param:automation_group}" }, "design": false, "operations": [
      { "operation": "read", "scope": "organization" }, { "operation": "list", "scope": "organization" }, { "operation": "update", "scope": "organization" } ] },
    { "principal": { "kind": "group", "id": "${param:project_admins}" }, "design": false, "operations": [
      { "operation": "read", "scope": "organization" }, { "operation": "list", "scope": "organization" } ] } ] },
  "conversation": null
}
