{
  "key": "section", "name": "Section", "description": "A section of a project's board.",
  "fields": [
    { "key": "project", "label": "Project", "type": "reference", "required": true, "target_entity_id": "${entity:project}",
      "on_target_delete": "restrict", "inverse_key": "sections", "inverse_label": "Sections" },
    { "key": "name", "label": "Name", "type": "text", "required": true },
    { "key": "description", "label": "Description", "type": "text", "format": "richtext" },
    { "key": "position", "label": "Position", "type": "number" },
    { "key": "tasks_done", "label": "Done", "type": "formula", "formula_result_type": "number", "rollup": { "inverseKey": "tasks", "agg": "count", "filter": [ { "field": "status", "op": "eq", "value": "done" } ] } },
    { "key": "tasks_total", "label": "Tasks", "type": "formula", "formula_result_type": "number", "rollup": { "inverseKey": "tasks", "agg": "count", "filter": [ { "field": "status", "op": "ne", "value": "cancelled" } ] } }
  ],
  "natural_key": [ { "id": "by_name", "name": "Name in its project", "fields": ["project", "name"] } ],
  "display_field": "name",
  "views": [ { "key": "all", "name": "Sections", "columns": ["name", "project", "position"] } ],
  "create_form": { "name": "Section", "schema": { "type": "object", "properties": {
    "project": { "type": "string", "format": "entity", "x-entity": "project", "x-entityField": "project" },
    "name": { "type": "string", "x-entityField": "name" },
    "description": { "type": "string", "x-entityField": "description" },
    "position": { "type": "number", "x-entityField": "position" } } } },
  "rules": [
    { "key": "project_is_fixed", "message": "A record cannot move to another project", "field": "project",
      "condition": { "join": "and", "leaves": [
        { "kind": "write", "write": { "op": "is_update" } },
        { "kind": "write", "write": { "op": "changed", "field": "project" } } ] } }
  ],
  "access": { "mode": "restricted", "grants": [
    { "principal": { "kind": "everyone" }, "operations": [
      { "operation": "read", "record_scopes": [ { "kind": "parent_field", "field": "project", "parent_field": "managers" }, { "kind": "parent_field", "field": "project", "parent_field": "members" } ] },
      { "operation": "list", "record_scopes": [ { "kind": "parent_field", "field": "project", "parent_field": "managers" }, { "kind": "parent_field", "field": "project", "parent_field": "members" } ] },
      { "operation": "create", "record_scopes": [ { "kind": "parent_field", "field": "project", "parent_field": "managers" } ] },
      { "operation": "update", "record_scopes": [ { "kind": "parent_field", "field": "project", "parent_field": "managers" } ] },
      { "operation": "delete", "record_scopes": [ { "kind": "parent_field", "field": "project", "parent_field": "managers" } ] } ] },
    { "principal": { "kind": "group", "id": "${param:project_admins}" }, "design": false, "operations": [
      { "operation": "read", "scope": "organization" }, { "operation": "list", "scope": "organization" } ] } ] },
  "conversation": null
}
