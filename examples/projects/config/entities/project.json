{
  "key": "project", "name": "Project", "description": "A project: its managers, members, sections and tasks.",
  "icon": "folder-kanban", "accent": "indigo",
  "fields": [
    { "key": "name", "label": "Name", "type": "text", "required": true, "searchable": true },
    { "key": "description", "label": "Description", "type": "text", "format": "richtext", "format_options": { "mentions": true } },
    { "key": "managers", "label": "Managers", "type": "reference_list", "required": true, "sortable": false,
      "target_entity_id": "ffffffff-0000-0000-0000-000000000001", "default": { "kind": "creator" } },
    { "key": "members", "label": "Members", "type": "reference_list", "sortable": false,
      "target_entity_id": "ffffffff-0000-0000-0000-000000000001" },
    { "key": "status", "label": "Status", "type": "enum", "facetable": true,
      "enum_values": [ { "value": "active", "label": "Active", "color": "emerald" }, { "value": "paused", "label": "Paused", "color": "amber" }, { "value": "closed", "label": "Closed", "color": "gray" } ],
      "default": { "kind": "literal", "value": "active" } },
    { "key": "unit", "label": "Unit", "type": "reference", "target_entity_id": "ffffffff-0000-0000-0000-000000000003" },
    { "key": "default_group_by", "label": "Group the board by", "type": "enum",
      "enum_values": ["status", "section", "owner", "due", "priority"] },
    { "key": "tasks_todo", "label": "To do", "type": "formula", "formula_result_type": "number", "rollup": { "inverseKey": "tasks", "agg": "count", "filter": [ { "field": "status", "op": "eq", "value": "todo" } ] } },
    { "key": "tasks_doing", "label": "In progress", "type": "formula", "formula_result_type": "number", "rollup": { "inverseKey": "tasks", "agg": "count", "filter": [ { "field": "status", "op": "eq", "value": "doing" } ] } },
    { "key": "tasks_done", "label": "Done", "type": "formula", "formula_result_type": "number", "rollup": { "inverseKey": "tasks", "agg": "count", "filter": [ { "field": "status", "op": "eq", "value": "done" } ] } }
  ],
  "natural_key": [],
  "display_field": "name",
  "views": [ { "key": "all", "name": "Projects", "columns": ["name", "status", "managers", "unit"] } ],
  "create_form": { "name": "Project", "schema": { "type": "object", "properties": {
    "name": { "type": "string", "x-entityField": "name" },
    "description": { "type": "string", "x-entityField": "description" },
    "managers": { "type": "array", "items": { "type": "string", "format": "entity" }, "x-entity": "user", "x-entityField": "managers" },
    "members": { "type": "array", "items": { "type": "string", "format": "entity" }, "x-entity": "user", "x-entityField": "members" },
    "unit": { "type": "string", "format": "entity", "x-entity": "org_unit", "x-entityField": "unit" } } } },
  "stage_model": { "status_field": "status", "initial_statuses": ["active"], "transitions": [
    { "from": "active", "to": "paused", "required_fields": [], "movers": [ { "kind": "in_field", "field": "managers" }, { "kind": "in_group", "group_id": "${param:project_admins}" } ] },
    { "from": "paused", "to": "active", "required_fields": [], "movers": [ { "kind": "in_field", "field": "managers" }, { "kind": "in_group", "group_id": "${param:project_admins}" } ] },
    { "from": "active", "to": "closed", "required_fields": [], "movers": [ { "kind": "in_field", "field": "managers" }, { "kind": "in_group", "group_id": "${param:project_admins}" } ] },
    { "from": "paused", "to": "closed", "required_fields": [], "movers": [ { "kind": "in_field", "field": "managers" }, { "kind": "in_group", "group_id": "${param:project_admins}" } ] },
    { "from": "closed", "to": "active", "required_fields": [], "movers": [ { "kind": "in_field", "field": "managers" }, { "kind": "in_group", "group_id": "${param:project_admins}" } ] } ] },
  "access": { "mode": "restricted", "grants": [
    { "principal": { "kind": "everyone" }, "operations": [
      { "operation": "read", "record_scopes": [ { "kind": "field", "field": "managers" }, { "kind": "field", "field": "members" } ] },
      { "operation": "list", "record_scopes": [ { "kind": "field", "field": "managers" }, { "kind": "field", "field": "members" } ] },
      { "operation": "update", "record_scopes": [ { "kind": "field", "field": "managers" } ] } ] },
    { "principal": { "kind": "group", "id": "${param:project_creators}" }, "design": false,
      "operations": [ { "operation": "create", "scope": "organization" } ] },
    { "principal": { "kind": "group", "id": "${param:automation_group}" }, "design": false,
      "operations": [ { "operation": "read", "scope": "organization" }, { "operation": "list", "scope": "organization" } ] },
    { "principal": { "kind": "group", "id": "${param:project_admins}" }, "design": false, "operations": [
      { "operation": "read", "scope": "organization" }, { "operation": "list", "scope": "organization" }, { "operation": "update", "scope": "organization" }, { "operation": "delete", "scope": "organization" } ] } ] },
  "conversation": null,
  "comments": { "enabled": true }
}
