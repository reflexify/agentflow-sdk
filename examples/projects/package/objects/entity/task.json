{
  "name": "Task",
  "description": "A task in a project.",
  "icon": "square-check",
  "accent": "sky",
  "access": "restricted",
  "fields": [
    "@obj:entity_field:task/title",
    "@obj:entity_field:task/project",
    "@obj:entity_field:task/section",
    "@obj:entity_field:task/position",
    "@obj:entity_field:task/description",
    "@obj:entity_field:task/status",
    "@obj:entity_field:task/blocked",
    "@obj:entity_field:task/label",
    "@obj:entity_field:task/collaborators",
    "@obj:entity_field:task/priority",
    "@obj:entity_field:task/due",
    "@obj:entity_field:task/checklist",
    "@obj:entity_field:task/attachments",
    "@obj:entity_field:task/checklist_done",
    "@obj:entity_field:task/checklist_total",
    "@obj:entity_field:task/show_checklist_on_card",
    "@obj:entity_field:task/origin",
    "@obj:entity_field:task/origin_ref",
    "@obj:entity_field:task/completed_at",
    "@obj:entity_field:task/frozen"
  ],
  "natural_key": [],
  "display_field": "title",
  "create_form": "@obj:form:task",
  "rules": [
    {
      "key": "content_by_owner_or_manager",
      "message": "Only the owner or a project manager changes this",
      "field": "title",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed_any",
              "fields": [
                "title",
                "description",
                "due",
                "priority",
                "collaborators"
              ]
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "is_holder"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_parent_field",
                "field": "project",
                "parent_field": "managers"
              }
            }
          }
        ]
      }
    },
    {
      "key": "board_by_participants",
      "message": "Only the owner, a collaborator or a project manager changes this",
      "field": "label",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed_any",
              "fields": [
                "label",
                "blocked",
                "section",
                "position",
                "checklist",
                "attachments"
              ]
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "is_holder"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_field",
                "field": "collaborators"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_parent_field",
                "field": "project",
                "parent_field": "managers"
              }
            }
          }
        ]
      }
    },
    {
      "key": "blocked_only_while_doing",
      "message": "Only a task in progress can be blocked",
      "field": "blocked",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "blocked",
              "op": "eq",
              "value": true
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "status",
              "op": "ne",
              "value": "doing"
            }
          }
        ]
      }
    },
    {
      "key": "label_matches_status",
      "message": "The label belongs to another status",
      "field": "label",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "label.base_status",
              "op": "ne",
              "value": {
                "$field": "status"
              }
            }
          }
        ]
      }
    },
    {
      "key": "section_in_project",
      "message": "The section belongs to another project",
      "field": "section",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "section.project",
              "op": "ne",
              "value": {
                "$field": "project"
              }
            }
          }
        ]
      }
    },
    {
      "key": "frozen_is_frozen",
      "message": "This task is frozen because its project is closed",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "was",
              "rule": {
                "field": "frozen",
                "op": "eq",
                "value": true
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:automation_group"
              }
            }
          }
        ]
      }
    },
    {
      "key": "project_is_fixed",
      "message": "A record cannot move to another project",
      "field": "project",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed",
              "field": "project"
            }
          }
        ]
      }
    },
    {
      "key": "no_task_in_closed_project",
      "message": "A closed project takes no new tasks",
      "field": "project",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_new"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "project.status",
              "op": "eq",
              "value": "closed"
            }
          }
        ]
      }
    }
  ],
  "stage_model": {
    "status_field": "status",
    "initial_statuses": [
      "todo"
    ],
    "transitions": [
      {
        "from": "todo",
        "to": "doing",
        "required_fields": [],
        "movers": [
          {
            "kind": "is_holder"
          },
          {
            "kind": "in_field",
            "field": "collaborators"
          },
          {
            "kind": "in_parent_field",
            "field": "project",
            "parent_field": "managers"
          }
        ]
      },
      {
        "from": "doing",
        "to": "todo",
        "required_fields": [],
        "movers": [
          {
            "kind": "is_holder"
          },
          {
            "kind": "in_field",
            "field": "collaborators"
          },
          {
            "kind": "in_parent_field",
            "field": "project",
            "parent_field": "managers"
          }
        ]
      },
      {
        "from": "doing",
        "to": "done",
        "required_fields": [],
        "movers": [
          {
            "kind": "is_holder"
          }
        ]
      },
      {
        "from": "todo",
        "to": "done",
        "required_fields": [],
        "movers": [
          {
            "kind": "is_holder"
          }
        ]
      },
      {
        "from": "done",
        "to": "doing",
        "required_fields": [],
        "movers": [
          {
            "kind": "in_parent_field",
            "field": "project",
            "parent_field": "managers"
          }
        ]
      },
      {
        "from": "todo",
        "to": "cancelled",
        "required_fields": [],
        "movers": [
          {
            "kind": "is_holder"
          },
          {
            "kind": "in_parent_field",
            "field": "project",
            "parent_field": "managers"
          }
        ]
      },
      {
        "from": "doing",
        "to": "cancelled",
        "required_fields": [],
        "movers": [
          {
            "kind": "is_holder"
          },
          {
            "kind": "in_parent_field",
            "field": "project",
            "parent_field": "managers"
          }
        ]
      },
      {
        "from": "cancelled",
        "to": "todo",
        "required_fields": [],
        "movers": [
          {
            "kind": "in_parent_field",
            "field": "project",
            "parent_field": "managers"
          }
        ]
      }
    ]
  },
  "work": {
    "lifecycle": {
      "status_field": "status",
      "categories": {
        "todo": "active",
        "doing": "active",
        "done": "done",
        "cancelled": "cancelled"
      }
    },
    "assignable": {
      "claim": "readers",
      "rules": [
        {
          "on": "start",
          "assign": [
            {
              "kind": "dynamic",
              "source": {
                "type": "creator"
              }
            }
          ]
        }
      ]
    },
    "work_surface": {
      "priority": {
        "field": "priority",
        "values": {
          "low": "low",
          "medium": "normal",
          "high": "high",
          "urgent": "urgent"
        }
      }
    }
  },
  "comments": {
    "enabled": true,
    "closed_when": {
      "join": "and",
      "leaves": [
        {
          "kind": "field",
          "rule": {
            "field": "frozen",
            "op": "eq",
            "value": true
          }
        }
      ]
    }
  }
}
