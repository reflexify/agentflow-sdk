{
  "schemaVersion": "1.0",
  "name": "Stamp completion",
  "description": "Sets a task's completed_at when it enters done, and clears it when it leaves done.",
  "runAs": "@param:automation_principal",
  "exposedSteps": [],
  "start": "start",
  "end": [
    "finish"
  ],
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "node_type": "start",
      "parameters": {
        "id": "start",
        "label": "Start",
        "inputContract": {
          "subject": {
            "kind": "entity",
            "entityId": "@obj:entity:task",
            "arity": "single"
          },
          "params": {
            "kind": "none"
          }
        }
      },
      "settings": {}
    },
    {
      "id": "task",
      "name": "Read the task",
      "node_type": "entity_record",
      "parameters": {
        "id": "task",
        "label": "Read the task",
        "operation": "get",
        "entityId": "@obj:entity:task",
        "recordIdExpr": {
          "kind": "reference",
          "value": "subject.record_id"
        }
      },
      "settings": {}
    },
    {
      "id": "is_done",
      "name": "Done?",
      "node_type": "decision",
      "parameters": {
        "id": "is_done",
        "label": "Done?",
        "branches": [
          {
            "edgeIds": [
              "e_done"
            ],
            "when": {
              "==": [
                {
                  "var": "nodes.task.output.record.status"
                },
                "done"
              ]
            }
          },
          {
            "edgeIds": [
              "e_not_done"
            ],
            "default": true
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "stamp",
      "name": "Stamp completion",
      "node_type": "entity_record",
      "parameters": {
        "id": "stamp",
        "label": "Stamp completion",
        "operation": "update",
        "entityId": "@obj:entity:task",
        "recordIdExpr": {
          "kind": "reference",
          "value": "subject.record_id"
        },
        "body": [
          {
            "field": "completed_at",
            "kind": "template",
            "value": "{{ now() }}"
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "clear",
      "name": "Clear completion",
      "node_type": "entity_record",
      "parameters": {
        "id": "clear",
        "label": "Clear completion",
        "operation": "update",
        "entityId": "@obj:entity:task",
        "recordIdExpr": {
          "kind": "reference",
          "value": "subject.record_id"
        },
        "body": [
          {
            "field": "completed_at",
            "kind": "reference",
            "value": ""
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "finish",
      "name": "Finish",
      "node_type": "end",
      "parameters": {
        "id": "finish",
        "label": "Finish",
        "outcomeLabel": "completed"
      },
      "settings": {}
    }
  ],
  "edges": [
    {
      "id": "e_start",
      "from": "start",
      "to": "task"
    },
    {
      "id": "e_read",
      "from": "task",
      "to": "is_done"
    },
    {
      "id": "e_done",
      "from": "is_done",
      "to": "stamp"
    },
    {
      "id": "e_not_done",
      "from": "is_done",
      "to": "clear"
    },
    {
      "id": "e_stamped",
      "from": "stamp",
      "to": "finish"
    },
    {
      "id": "e_cleared",
      "from": "clear",
      "to": "finish"
    }
  ]
}
