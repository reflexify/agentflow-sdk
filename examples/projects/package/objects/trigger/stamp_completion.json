{
  "workflow": "@obj:workflow:stamp_completion",
  "kind": "entity_record",
  "enabled": false,
  "config": {
    "entity_id": "@obj:entity:task",
    "change_kind": "updated",
    "filter": {
      "and": [
        {
          "in": [
            "status",
            {
              "var": "event.changed"
            }
          ]
        },
        {
          "or": [
            {
              "==": [
                {
                  "var": "status"
                },
                "done"
              ]
            },
            {
              "==": [
                {
                  "var": "event.previous.status"
                },
                "done"
              ]
            }
          ]
        }
      ]
    },
    "input_mappings": []
  }
}
