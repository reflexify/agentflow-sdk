# Copy to .env (`pnpm setup-keys` does it, with a fresh session key and the key id filled in).
# The server reads this file; the browser never sees any of it.

# The identity provider AgentFlow signs people in with. Required; no default.
AGENTFLOW_ISSUER=
# The id of the public key in keys/public.jwk.json. `pnpm setup-keys` fills it in.
AGENTFLOW_PRIVATE_KEY_ID=
# 32 random bytes in base64url (43 characters). `pnpm setup-keys` fills it in.
PROJECTS_SESSION_KEY=

# The origin this site is served at: http(s), no path. Default http://localhost:5175
# PROJECTS_ORIGIN=http://localhost:5175
# Where the site listens. Default 5175
# PORT=5175
# The client id registered with AgentFlow. Default projects-dev
# AGENTFLOW_CLIENT_ID=projects-dev
# The private key setup-keys wrote. Default keys/private.pem
# AGENTFLOW_PRIVATE_KEY_FILE=keys/private.pem
# The ids of the Projects entities and groups; copy projects.config.example.json. Default projects.config.json
# PROJECTS_CONFIG_FILE=projects.config.json
# AgentFlow's API. Default http://localhost:8080/api/v1
# AGENTFLOW_API_BASE_URL=http://localhost:8080/api/v1
# The audience of the access token. Default: the API address followed by /rest
# AGENTFLOW_RESOURCE=
# The AgentFlow web app, where the site links back to: http(s), no path. Default http://localhost:4000
# AGENTFLOW_APP_URL=http://localhost:4000
# The organization to sign in to when the person belongs to several. Default: none
# AGENTFLOW_ORG_HINT=
