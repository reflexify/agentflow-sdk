{
  "name": "Ticket",
  "description": "One customer issue and its conversation.",
  "icon": "ticket",
  "accent": "violet",
  "access": "restricted",
  "fields": [
    "@obj:entity_field:ticket/number",
    "@obj:entity_field:ticket/subject",
    "@obj:entity_field:ticket/status",
    "@obj:entity_field:ticket/priority",
    "@obj:entity_field:ticket/requester",
    "@obj:entity_field:ticket/last_customer_at",
    "@obj:entity_field:ticket/answered_revision",
    "@obj:entity_field:ticket/pending_since",
    "@obj:entity_field:ticket/pending_token",
    "@obj:entity_field:ticket/first_replied_at",
    "@obj:entity_field:ticket/escalated_at",
    "@obj:entity_field:ticket/possible_duplicate_of",
    "@obj:entity_field:ticket/summary",
    "@obj:entity_field:ticket/intent"
  ],
  "natural_key": [],
  "display_field": "number",
  "create_form": "@obj:form:ticket",
  "conversation": {
    "messages": {
      "entity_id": "@obj:entity:reply",
      "via": "ticket"
    },
    "order": "posted_at",
    "author": {
      "field": "author_kind",
      "speakers": {
        "customer": "user",
        "unverified": "exclude",
        "agent": "assistant",
        "bot": "assistant"
      }
    },
    "body": "body",
    "attachments": "attachments",
    "status": {
      "field": "status",
      "draft": "draft"
    },
    "key": "key"
  }
}
