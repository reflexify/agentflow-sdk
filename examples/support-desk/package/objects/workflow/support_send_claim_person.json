{
  "schemaVersion": "1.0",
  "name": "Support · Send reply · claim (person)",
  "description": "All or nothing: claims the draft once, emails it, and records the answer on the ticket.",
  "runAs": "initiator",
  "exposedSteps": [],
  "inputSchema": {
    "type": "object",
    "properties": {
      "version": {
        "type": "integer"
      },
      "body": {
        "type": "string"
      },
      "to": {
        "type": "string"
      },
      "cc": {
        "type": "string"
      },
      "subject": {
        "type": "string"
      },
      "in_reply_to": {
        "type": "string"
      },
      "references": {
        "type": "string"
      },
      "reply_to": {
        "type": "string"
      },
      "ticket_id": {
        "type": "string"
      },
      "author_user": {
        "type": "string"
      }
    },
    "required": [
      "version",
      "body",
      "to",
      "subject",
      "reply_to",
      "ticket_id"
    ]
  },
  "transaction": "atomic",
  "start": "start",
  "end": [
    "end_sent",
    "end_skipped"
  ],
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "node_type": "start",
      "parameters": {
        "id": "start",
        "label": "Start",
        "inputContract": {
          "subject": {
            "kind": "entity",
            "entityId": "@obj:entity:reply",
            "arity": "single"
          },
          "params": {
            "kind": "schema"
          }
        }
      },
      "settings": {}
    },
    {
      "id": "claim",
      "name": "Claim the draft",
      "node_type": "entity_record",
      "parameters": {
        "id": "claim",
        "label": "Claim the draft",
        "operation": "update",
        "entityId": "@obj:entity:reply",
        "recordIdExpr": {
          "kind": "reference",
          "value": "subject.record_id"
        },
        "body": [
          {
            "field": "status",
            "kind": "literal",
            "value": "sending"
          },
          {
            "field": "author_kind",
            "kind": "literal",
            "value": "agent"
          },
          {
            "field": "author_user",
            "kind": "reference",
            "value": "input.author_user"
          },
          {
            "field": "body",
            "kind": "reference",
            "value": "input.body"
          },
          {
            "field": "posted_at",
            "kind": "template",
            "value": "{{ now() }}"
          }
        ],
        "expect": {
          "version": "{{ input.version }}",
          "fields": {
            "status": "draft"
          }
        }
      },
      "settings": {}
    },
    {
      "id": "claimed",
      "name": "Claimed?",
      "node_type": "decision",
      "parameters": {
        "id": "claimed",
        "label": "Claimed?",
        "branches": [
          {
            "edgeIds": [
              "e_skipped"
            ],
            "when": {
              "==": [
                {
                  "var": "nodes.claim.output.skipped"
                },
                true
              ]
            }
          },
          {
            "edgeIds": [
              "e_claimed"
            ],
            "default": true
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "revision",
      "name": "Revision with this reply",
      "node_type": "entity_record",
      "parameters": {
        "id": "revision",
        "label": "Revision with this reply",
        "operation": "get",
        "entityId": "@obj:entity:ticket",
        "recordIdExpr": {
          "kind": "reference",
          "value": "input.ticket_id"
        }
      },
      "settings": {}
    },
    {
      "id": "email",
      "name": "Send the email",
      "node_type": "email",
      "parameters": {
        "id": "email",
        "label": "Send the email",
        "email": {
          "connection": "@param:resend_connection_id",
          "to": "{{ input.to }}",
          "delivery": "together",
          "cc": "{{ input.cc }}",
          "replyTo": "{{ input.reply_to }}",
          "subject": "{{ input.subject }}",
          "body": "{{ input.body }}",
          "headers": {
            "In-Reply-To": "{{ input.in_reply_to }}",
            "References": "{{ input.references }}"
          },
          "autoSubmitted": "none",
          "attachments": [
            {
              "fromExpr": "nodes.claim.output.record.attachments"
            }
          ]
        }
      },
      "settings": {}
    },
    {
      "id": "sent",
      "name": "Mark sent",
      "node_type": "entity_record",
      "parameters": {
        "id": "sent",
        "label": "Mark sent",
        "operation": "update",
        "entityId": "@obj:entity:reply",
        "recordIdExpr": {
          "kind": "reference",
          "value": "subject.record_id"
        },
        "body": [
          {
            "field": "status",
            "kind": "literal",
            "value": "sent"
          },
          {
            "field": "outbound_id",
            "kind": "reference",
            "value": "nodes.email.output.messages[0].outbound_id"
          },
          {
            "field": "key",
            "kind": "template",
            "value": "{{ nodes.email.output.messages[0].message_id or ('outbound:' ~ nodes.email.output.messages[0].outbound_id) }}"
          },
          {
            "field": "in_reply_to",
            "kind": "reference",
            "value": "input.in_reply_to"
          },
          {
            "field": "references",
            "kind": "reference",
            "value": "input.references"
          },
          {
            "field": "to",
            "kind": "reference",
            "value": "input.to"
          },
          {
            "field": "cc",
            "kind": "reference",
            "value": "input.cc"
          },
          {
            "field": "ai_unchanged",
            "kind": "template",
            "value": "{{ (nodes.claim.output.record.ai_body or '') | trim != '' and (nodes.claim.output.record.ai_body or '') | trim == (input.body or '') | trim }}"
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "ticket_sent",
      "name": "Record the answer",
      "node_type": "entity_record",
      "parameters": {
        "id": "ticket_sent",
        "label": "Record the answer",
        "operation": "update",
        "entityId": "@obj:entity:ticket",
        "recordIdExpr": {
          "kind": "reference",
          "value": "input.ticket_id"
        },
        "body": [
          {
            "field": "pending_token",
            "kind": "template",
            "value": "outbound:{{ nodes.email.output.messages[0].outbound_id }}"
          },
          {
            "field": "first_replied_at",
            "kind": "template",
            "value": "{{ nodes.revision.output.record.first_replied_at or now() }}"
          },
          {
            "field": "answered_revision",
            "kind": "reference",
            "value": "nodes.revision.output.conversation_revision"
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "end_sent",
      "name": "Sent",
      "node_type": "end",
      "parameters": {
        "id": "end_sent",
        "label": "Sent",
        "outcomeLabel": "Sent",
        "outputMapping": {
          "status": {
            "kind": "literal",
            "value": "sent"
          },
          "outbound_id": {
            "kind": "reference",
            "value": "nodes.email.output.messages[0].outbound_id"
          },
          "skip_reason": {
            "kind": "literal",
            "value": ""
          }
        }
      },
      "settings": {}
    },
    {
      "id": "end_skipped",
      "name": "Not sent",
      "node_type": "end",
      "parameters": {
        "id": "end_skipped",
        "label": "Not sent",
        "outcomeLabel": "Not sent",
        "outputMapping": {
          "status": {
            "kind": "literal",
            "value": "skipped"
          },
          "outbound_id": {
            "kind": "literal",
            "value": ""
          },
          "skip_reason": {
            "kind": "reference",
            "value": "nodes.claim.output.skip_reason"
          }
        }
      },
      "settings": {}
    }
  ],
  "edges": [
    {
      "id": "e_start",
      "from": "start",
      "to": "claim"
    },
    {
      "id": "e_c",
      "from": "claim",
      "to": "claimed"
    },
    {
      "id": "e_skipped",
      "from": "claimed",
      "to": "end_skipped"
    },
    {
      "id": "e_claimed",
      "from": "claimed",
      "to": "revision"
    },
    {
      "id": "e_rev",
      "from": "revision",
      "to": "email"
    },
    {
      "id": "e_em",
      "from": "email",
      "to": "sent"
    },
    {
      "id": "e_s",
      "from": "sent",
      "to": "ticket_sent"
    },
    {
      "id": "e_ts",
      "from": "ticket_sent",
      "to": "end_sent"
    }
  ]
}
