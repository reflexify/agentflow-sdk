{
  "schemaVersion": "1.0",
  "name": "Support · Move to a new ticket · apply",
  "description": "All or nothing: a new ticket for the sender, and the held message moved onto it. Ends \"Already decided\" if another person got there first.",
  "runAs": "initiator",
  "exposedSteps": [],
  "inputSchema": {
    "type": "object",
    "properties": {
      "clean_subject": {
        "type": "string"
      }
    },
    "required": [
      "clean_subject"
    ]
  },
  "transaction": "atomic",
  "start": "start",
  "end": [
    "end_moved",
    "end_decided"
  ],
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "node_type": "start",
      "parameters": {
        "id": "start",
        "label": "Start",
        "inputContract": {
          "subject": {
            "kind": "entity",
            "entityId": "@obj:entity:reply",
            "arity": "single"
          },
          "params": {
            "kind": "schema"
          }
        }
      },
      "settings": {}
    },
    {
      "id": "lock",
      "name": "Take the message",
      "node_type": "entity_record",
      "parameters": {
        "id": "lock",
        "label": "Take the message",
        "operation": "update",
        "entityId": "@obj:entity:reply",
        "recordIdExpr": {
          "kind": "reference",
          "value": "subject.record_id"
        },
        "body": [
          {
            "field": "author_kind",
            "kind": "literal",
            "value": "unverified"
          }
        ],
        "expect": {
          "fields": {
            "author_kind": "unverified"
          }
        }
      },
      "settings": {}
    },
    {
      "id": "still_held",
      "name": "Still held?",
      "node_type": "decision",
      "parameters": {
        "id": "still_held",
        "label": "Still held?",
        "branches": [
          {
            "edgeIds": [
              "e_decided"
            ],
            "when": {
              "==": [
                {
                  "var": "nodes.lock.output.skipped"
                },
                true
              ]
            }
          },
          {
            "edgeIds": [
              "e_held"
            ],
            "default": true
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "contact_upsert",
      "name": "Find or make the contact",
      "node_type": "entity_record",
      "parameters": {
        "id": "contact_upsert",
        "label": "Find or make the contact",
        "operation": "upsert",
        "entityId": "@obj:entity:contact",
        "matchBy": "key",
        "matchKey": "email",
        "body": [
          {
            "field": "email",
            "kind": "reference",
            "value": "subject.record.from_address"
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "contact_made",
      "name": "New contact?",
      "node_type": "decision",
      "parameters": {
        "id": "contact_made",
        "label": "New contact?",
        "branches": [
          {
            "edgeIds": [
              "e_made"
            ],
            "when": {
              "==": [
                {
                  "var": "nodes.contact_upsert.output.created"
                },
                true
              ]
            }
          },
          {
            "edgeIds": [
              "e_found"
            ],
            "default": true
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "contact_name",
      "name": "Name the new contact",
      "node_type": "entity_record",
      "parameters": {
        "id": "contact_name",
        "label": "Name the new contact",
        "operation": "update",
        "entityId": "@obj:entity:contact",
        "recordIdExpr": {
          "kind": "reference",
          "value": "nodes.contact_upsert.output.record.id"
        },
        "body": [
          {
            "field": "name",
            "kind": "reference",
            "value": "subject.record.from_address"
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "set_contact",
      "name": "Use the contact",
      "node_type": "set_variable",
      "parameters": {
        "id": "set_contact",
        "label": "Use the contact",
        "assignments": [
          {
            "target": "contact_id",
            "kind": "reference",
            "value": "nodes.contact_upsert.output.record.id"
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "ticket_create",
      "name": "New ticket",
      "node_type": "entity_record",
      "parameters": {
        "id": "ticket_create",
        "label": "New ticket",
        "operation": "create",
        "entityId": "@obj:entity:ticket",
        "body": [
          {
            "field": "subject",
            "kind": "reference",
            "value": "input.clean_subject"
          },
          {
            "field": "requester",
            "kind": "reference",
            "value": "vars.contact_id"
          },
          {
            "field": "status",
            "kind": "literal",
            "value": "new"
          },
          {
            "field": "priority",
            "kind": "literal",
            "value": "normal"
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "move",
      "name": "Move the message",
      "node_type": "entity_record",
      "parameters": {
        "id": "move",
        "label": "Move the message",
        "operation": "update",
        "entityId": "@obj:entity:reply",
        "recordIdExpr": {
          "kind": "reference",
          "value": "subject.record_id"
        },
        "body": [
          {
            "field": "ticket",
            "kind": "reference",
            "value": "nodes.ticket_create.output.record.id"
          },
          {
            "field": "author_kind",
            "kind": "literal",
            "value": "customer"
          }
        ],
        "expect": {
          "fields": {
            "author_kind": "unverified"
          }
        }
      },
      "settings": {}
    },
    {
      "id": "moved",
      "name": "Moved?",
      "node_type": "decision",
      "parameters": {
        "id": "moved",
        "label": "Moved?",
        "branches": [
          {
            "edgeIds": [
              "e_moved"
            ],
            "when": {
              "==": [
                {
                  "var": "nodes.move.output.skipped"
                },
                false
              ]
            }
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "ticket_open",
      "name": "Open the new ticket",
      "node_type": "entity_record",
      "parameters": {
        "id": "ticket_open",
        "label": "Open the new ticket",
        "operation": "update",
        "entityId": "@obj:entity:ticket",
        "recordIdExpr": {
          "kind": "reference",
          "value": "nodes.ticket_create.output.record.id"
        },
        "body": [
          {
            "field": "status",
            "kind": "literal",
            "value": "open"
          },
          {
            "field": "last_customer_at",
            "kind": "template",
            "value": "{{ now() }}"
          },
          {
            "field": "pending_token",
            "kind": "template",
            "value": "customer:{{ subject.record_id }}"
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "end_moved",
      "name": "Moved",
      "node_type": "end",
      "parameters": {
        "id": "end_moved",
        "label": "Moved",
        "outcomeLabel": "Moved",
        "outputMapping": {
          "moved": {
            "kind": "literal",
            "value": "true"
          },
          "ticket_id": {
            "kind": "reference",
            "value": "nodes.ticket_create.output.record.id"
          }
        }
      },
      "settings": {}
    },
    {
      "id": "end_decided",
      "name": "Already decided",
      "node_type": "end",
      "parameters": {
        "id": "end_decided",
        "label": "Already decided",
        "outcomeLabel": "Already decided",
        "outputMapping": {
          "moved": {
            "kind": "literal",
            "value": "false"
          },
          "ticket_id": {
            "kind": "literal",
            "value": ""
          }
        }
      },
      "settings": {}
    }
  ],
  "edges": [
    {
      "id": "e_start",
      "from": "start",
      "to": "lock"
    },
    {
      "id": "e_lock",
      "from": "lock",
      "to": "still_held"
    },
    {
      "id": "e_decided",
      "from": "still_held",
      "to": "end_decided"
    },
    {
      "id": "e_held",
      "from": "still_held",
      "to": "contact_upsert"
    },
    {
      "id": "e_cu",
      "from": "contact_upsert",
      "to": "contact_made"
    },
    {
      "id": "e_made",
      "from": "contact_made",
      "to": "contact_name"
    },
    {
      "id": "e_found",
      "from": "contact_made",
      "to": "set_contact"
    },
    {
      "id": "e_cn",
      "from": "contact_name",
      "to": "set_contact"
    },
    {
      "id": "e_sc",
      "from": "set_contact",
      "to": "ticket_create"
    },
    {
      "id": "e_tc",
      "from": "ticket_create",
      "to": "move"
    },
    {
      "id": "e_mv",
      "from": "move",
      "to": "moved"
    },
    {
      "id": "e_moved",
      "from": "moved",
      "to": "ticket_open"
    },
    {
      "id": "e_to",
      "from": "ticket_open",
      "to": "end_moved"
    }
  ]
}
