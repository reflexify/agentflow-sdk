{
  "schemaVersion": "1.0",
  "name": "Support · Close idle tickets",
  "description": "Daily: closes tickets waiting on the customer for 7 business days, unless anything moved since.",
  "runAs": "@param:automation_principal_id",
  "exposedSteps": [],
  "start": "start",
  "end": [
    "end_done"
  ],
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "node_type": "start",
      "parameters": {
        "id": "start",
        "label": "Start",
        "inputContract": {
          "subject": {
            "kind": "none"
          },
          "params": {
            "kind": "none"
          }
        }
      },
      "settings": {}
    },
    {
      "id": "idle",
      "name": "Idle pending tickets",
      "node_type": "entity_record",
      "parameters": {
        "id": "idle",
        "label": "Idle pending tickets",
        "operation": "search",
        "entityId": "@obj:entity:ticket",
        "filters": [
          {
            "field": "status",
            "op": "eq",
            "value": {
              "kind": "literal",
              "value": "pending"
            }
          },
          {
            "field": "pending_token",
            "op": "is_not_empty",
            "value": {
              "kind": "literal",
              "value": ""
            }
          },
          {
            "field": "pending_since",
            "op": "lte",
            "value": {
              "kind": "template",
              "value": "{{ now() | add_business_days(-7) }}"
            }
          }
        ],
        "sort": "pending_since",
        "dir": "asc",
        "limit": 500
      },
      "settings": {}
    },
    {
      "id": "each",
      "name": "Close each",
      "node_type": "for_each",
      "parameters": {
        "id": "each",
        "label": "Close each",
        "listSource": "nodes.idle.output.records",
        "itemAlias": "item",
        "mode": "sequential",
        "continueOnItemFailure": true,
        "failOnItemFailure": false,
        "body": {
          "schemaVersion": "1.0",
          "start": "bs",
          "end": [
            "be"
          ],
          "nodes": [
            {
              "id": "bs",
              "name": "Item",
              "node_type": "start",
              "parameters": {
                "id": "bs",
                "label": "Item"
              },
              "settings": {}
            },
            {
              "id": "close",
              "name": "Close it",
              "node_type": "entity_record",
              "parameters": {
                "id": "close",
                "label": "Close it",
                "operation": "update",
                "entityId": "@obj:entity:ticket",
                "recordIdExpr": {
                  "kind": "reference",
                  "value": "input.item.id"
                },
                "body": [
                  {
                    "field": "status",
                    "kind": "literal",
                    "value": "closed"
                  }
                ],
                "expect": {
                  "fields": {
                    "status": "pending",
                    "pending_token": "{{ input.item.pending_token }}"
                  }
                }
              },
              "settings": {}
            },
            {
              "id": "closed",
              "name": "Closed?",
              "node_type": "decision",
              "parameters": {
                "id": "closed",
                "label": "Closed?",
                "branches": [
                  {
                    "edgeIds": [
                      "be_closed"
                    ],
                    "when": {
                      "==": [
                        {
                          "var": "nodes.close.output.skipped"
                        },
                        false
                      ]
                    }
                  },
                  {
                    "edgeIds": [
                      "be_kept"
                    ],
                    "default": true
                  }
                ]
              },
              "settings": {}
            },
            {
              "id": "note",
              "name": "Event: closed",
              "node_type": "entity_record",
              "parameters": {
                "id": "note",
                "label": "Event: closed",
                "operation": "create",
                "entityId": "@obj:entity:note",
                "body": [
                  {
                    "field": "ticket",
                    "kind": "reference",
                    "value": "input.item.id"
                  },
                  {
                    "field": "kind",
                    "kind": "literal",
                    "value": "event"
                  },
                  {
                    "field": "body",
                    "kind": "literal",
                    "value": "Closed: no reply from the customer for 7 business days"
                  }
                ]
              },
              "settings": {}
            },
            {
              "id": "be",
              "name": "Done",
              "node_type": "end",
              "parameters": {
                "id": "be",
                "label": "Done"
              },
              "settings": {}
            }
          ],
          "edges": [
            {
              "id": "be0",
              "from": "bs",
              "to": "close"
            },
            {
              "id": "be1",
              "from": "close",
              "to": "closed"
            },
            {
              "id": "be_closed",
              "from": "closed",
              "to": "note"
            },
            {
              "id": "be_kept",
              "from": "closed",
              "to": "be"
            },
            {
              "id": "be2",
              "from": "note",
              "to": "be"
            }
          ]
        }
      },
      "settings": {}
    },
    {
      "id": "end_done",
      "name": "Done",
      "node_type": "end",
      "parameters": {
        "id": "end_done",
        "label": "Done",
        "outcomeLabel": "Done",
        "outputMapping": {
          "checked": {
            "kind": "reference",
            "value": "nodes.idle.output.returnedCount",
            "label": "Tickets checked"
          }
        }
      },
      "settings": {}
    }
  ],
  "edges": [
    {
      "id": "e_start",
      "from": "start",
      "to": "idle"
    },
    {
      "id": "e_i",
      "from": "idle",
      "to": "each"
    },
    {
      "id": "e_e",
      "from": "each",
      "to": "end_done"
    }
  ]
}
