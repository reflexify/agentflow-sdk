{
  "schemaVersion": "1.0",
  "name": "Support · Move to a new ticket",
  "description": "A person moves a held message to a new ticket for its sender, and a reply is drafted there.",
  "runAs": "initiator",
  "exposedSteps": [],
  "start": "start",
  "end": [
    "end_moved",
    "end_not_moved"
  ],
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "node_type": "start",
      "parameters": {
        "id": "start",
        "label": "Start",
        "inputContract": {
          "subject": {
            "kind": "entity",
            "entityId": "@obj:entity:reply",
            "arity": "single"
          },
          "params": {
            "kind": "none"
          }
        }
      },
      "settings": {}
    },
    {
      "id": "clean",
      "name": "Clean the subject",
      "node_type": "code",
      "parameters": {
        "id": "clean",
        "label": "Clean the subject",
        "language": "javascript",
        "source": "// A held message's subject as its own ticket's: without reply prefixes and the\n// ticket number the sender guessed. The same rule Intake applies to a new\n// ticket's subject (intake-candidates.js); a test holds the two together.\n\nconst TOKEN = /\\[(TK-\\d{4}-\\d+)\\]/gi;\n\nfunction main(inputs) {\n  const subject = typeof inputs.subject === \"string\" ? inputs.subject.trim() : \"\";\n  let clean = subject.replace(TOKEN, \" \");\n  for (;;) {\n    const next = clean.replace(/^\\s*(re|fwd?|aw|sv)\\s*:\\s*/i, \"\");\n    if (next === clean) break;\n    clean = next;\n  }\n  clean = clean.replace(/\\s+/g, \" \").trim();\n  return { clean_subject: clean || \"(no subject)\" };\n}\n",
        "inputs": [
          {
            "name": "subject",
            "kind": "reference",
            "value": "subject.record.subject"
          }
        ],
        "outputSchema": {
          "type": "object",
          "properties": {
            "clean_subject": {
              "type": "string"
            }
          },
          "required": [
            "clean_subject"
          ]
        },
        "timeoutSecs": 10
      },
      "settings": {}
    },
    {
      "id": "apply",
      "name": "Move it",
      "node_type": "call_workflow",
      "parameters": {
        "id": "apply",
        "label": "Move it",
        "workflowId": "@obj:workflow:support_move_apply",
        "inputBindings": [
          {
            "target": "clean_subject",
            "kind": "reference",
            "value": "nodes.clean.output.clean_subject"
          }
        ],
        "subjectSource": "subject.record_id"
      },
      "settings": {}
    },
    {
      "id": "did_move",
      "name": "Moved?",
      "node_type": "decision",
      "parameters": {
        "id": "did_move",
        "label": "Moved?",
        "branches": [
          {
            "edgeIds": [
              "e_moved"
            ],
            "when": {
              "!!": [
                {
                  "var": "nodes.apply.output.ticket_id"
                }
              ]
            }
          },
          {
            "edgeIds": [
              "e_not_moved"
            ],
            "default": true
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "draft",
      "name": "Draft a reply",
      "node_type": "call_workflow",
      "parameters": {
        "id": "draft",
        "label": "Draft a reply",
        "workflowId": "@obj:workflow:support_draft_reply",
        "inputBindings": [],
        "subjectSource": "nodes.apply.output.ticket_id"
      },
      "settings": {
        "error_handling": {
          "strategy": "continue",
          "default_output": {
            "skipped": true
          }
        }
      }
    },
    {
      "id": "end_moved",
      "name": "Moved",
      "node_type": "end",
      "parameters": {
        "id": "end_moved",
        "label": "Moved",
        "outcomeLabel": "Moved",
        "outputMapping": {
          "ticket_id": {
            "kind": "reference",
            "value": "nodes.apply.output.ticket_id",
            "label": "New ticket",
            "showAs": "record",
            "entityId": "@obj:entity:ticket"
          }
        }
      },
      "settings": {}
    },
    {
      "id": "end_not_moved",
      "name": "Not moved",
      "node_type": "end",
      "parameters": {
        "id": "end_not_moved",
        "label": "Not moved",
        "outcomeLabel": "Already decided"
      },
      "settings": {}
    }
  ],
  "edges": [
    {
      "id": "e_start",
      "from": "start",
      "to": "clean"
    },
    {
      "id": "e_c",
      "from": "clean",
      "to": "apply"
    },
    {
      "id": "e_a",
      "from": "apply",
      "to": "did_move"
    },
    {
      "id": "e_moved",
      "from": "did_move",
      "to": "draft"
    },
    {
      "id": "e_not_moved",
      "from": "did_move",
      "to": "end_not_moved"
    },
    {
      "id": "e_d",
      "from": "draft",
      "to": "end_moved"
    }
  ]
}
