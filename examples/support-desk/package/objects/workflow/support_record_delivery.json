{
  "schemaVersion": "1.0",
  "name": "Support · Record delivery",
  "description": "Finds the sent reply a delivery event names, and records what happened to it.",
  "runAs": "initiator",
  "exposedSteps": [],
  "inputSchema": {
    "type": "object",
    "properties": {
      "outbound_id": {
        "type": "string"
      },
      "provider_id": {
        "type": "string"
      },
      "message_id": {
        "type": "string"
      },
      "outcome": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      }
    }
  },
  "transaction": "atomic",
  "start": "start",
  "end": [
    "end_recorded",
    "end_unmatched"
  ],
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "node_type": "start",
      "parameters": {
        "id": "start",
        "label": "Start",
        "inputContract": {
          "subject": {
            "kind": "none"
          },
          "params": {
            "kind": "schema"
          }
        }
      },
      "settings": {}
    },
    {
      "id": "tagged",
      "name": "Names our message?",
      "node_type": "decision",
      "parameters": {
        "id": "tagged",
        "label": "Names our message?",
        "branches": [
          {
            "edgeIds": [
              "e_tagged"
            ],
            "when": {
              "!!": [
                {
                  "var": "input.outbound_id"
                }
              ]
            }
          },
          {
            "edgeIds": [
              "e_untagged"
            ],
            "default": true
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "reply",
      "name": "Find the reply",
      "node_type": "entity_record",
      "parameters": {
        "id": "reply",
        "label": "Find the reply",
        "operation": "search",
        "entityId": "@obj:entity:reply",
        "filters": [
          {
            "field": "outbound_id",
            "op": "eq",
            "value": {
              "kind": "reference",
              "value": "input.outbound_id"
            }
          }
        ],
        "limit": 1
      },
      "settings": {}
    },
    {
      "id": "found",
      "name": "Found?",
      "node_type": "decision",
      "parameters": {
        "id": "found",
        "label": "Found?",
        "branches": [
          {
            "edgeIds": [
              "e_found"
            ],
            "when": {
              ">": [
                {
                  "var": "nodes.reply.output.returnedCount"
                },
                0
              ]
            }
          },
          {
            "edgeIds": [
              "e_missing"
            ],
            "default": true
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "delivered",
      "name": "Record delivery",
      "node_type": "entity_record",
      "parameters": {
        "id": "delivered",
        "label": "Record delivery",
        "operation": "update",
        "entityId": "@obj:entity:reply",
        "recordIdExpr": {
          "kind": "reference",
          "value": "nodes.reply.output.records[0].id"
        },
        "body": [
          {
            "field": "provider_id",
            "kind": "reference",
            "value": "input.provider_id"
          },
          {
            "field": "key",
            "kind": "template",
            "value": "{{ input.message_id if (input.message_id and nodes.reply.output.records[0].key[:9] == 'outbound:') else nodes.reply.output.records[0].key }}"
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "outcome",
      "name": "Delivered?",
      "node_type": "decision",
      "parameters": {
        "id": "outcome",
        "label": "Delivered?",
        "branches": [
          {
            "edgeIds": [
              "e_ok"
            ],
            "when": {
              "==": [
                {
                  "var": "input.outcome"
                },
                "delivered"
              ]
            }
          },
          {
            "edgeIds": [
              "e_failed"
            ],
            "default": true
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "mark_failed",
      "name": "Mark failed",
      "node_type": "entity_record",
      "parameters": {
        "id": "mark_failed",
        "label": "Mark failed",
        "operation": "update",
        "entityId": "@obj:entity:reply",
        "recordIdExpr": {
          "kind": "reference",
          "value": "nodes.reply.output.records[0].id"
        },
        "body": [
          {
            "field": "status",
            "kind": "literal",
            "value": "failed"
          }
        ],
        "expect": {
          "fields": {
            "status": "sent"
          }
        }
      },
      "settings": {}
    },
    {
      "id": "newly_failed",
      "name": "Newly failed?",
      "node_type": "decision",
      "parameters": {
        "id": "newly_failed",
        "label": "Newly failed?",
        "branches": [
          {
            "edgeIds": [
              "e_already"
            ],
            "when": {
              "==": [
                {
                  "var": "nodes.mark_failed.output.skipped"
                },
                true
              ]
            }
          },
          {
            "edgeIds": [
              "e_newly"
            ],
            "default": true
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "note_failed",
      "name": "Note: not delivered",
      "node_type": "entity_record",
      "parameters": {
        "id": "note_failed",
        "label": "Note: not delivered",
        "operation": "create",
        "entityId": "@obj:entity:note",
        "body": [
          {
            "field": "ticket",
            "kind": "reference",
            "value": "nodes.reply.output.records[0].ticket"
          },
          {
            "field": "kind",
            "kind": "literal",
            "value": "system"
          },
          {
            "field": "body",
            "kind": "template",
            "value": "A reply was not delivered ({{ input.outcome }}): {{ input.reason or 'no reason given' }}."
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "end_recorded",
      "name": "Recorded",
      "node_type": "end",
      "parameters": {
        "id": "end_recorded",
        "label": "Recorded",
        "outcomeLabel": "Recorded"
      },
      "settings": {}
    },
    {
      "id": "end_unmatched",
      "name": "Not ours",
      "node_type": "end",
      "parameters": {
        "id": "end_unmatched",
        "label": "Not ours",
        "outcomeLabel": "Not ours"
      },
      "settings": {}
    }
  ],
  "edges": [
    {
      "id": "e_start",
      "from": "start",
      "to": "tagged"
    },
    {
      "id": "e_tagged",
      "from": "tagged",
      "to": "reply"
    },
    {
      "id": "e_untagged",
      "from": "tagged",
      "to": "end_unmatched"
    },
    {
      "id": "e_r",
      "from": "reply",
      "to": "found"
    },
    {
      "id": "e_found",
      "from": "found",
      "to": "delivered"
    },
    {
      "id": "e_missing",
      "from": "found",
      "to": "end_unmatched"
    },
    {
      "id": "e_d",
      "from": "delivered",
      "to": "outcome"
    },
    {
      "id": "e_ok",
      "from": "outcome",
      "to": "end_recorded"
    },
    {
      "id": "e_failed",
      "from": "outcome",
      "to": "mark_failed"
    },
    {
      "id": "e_mf",
      "from": "mark_failed",
      "to": "newly_failed"
    },
    {
      "id": "e_already",
      "from": "newly_failed",
      "to": "end_recorded"
    },
    {
      "id": "e_newly",
      "from": "newly_failed",
      "to": "note_failed"
    },
    {
      "id": "e_nf",
      "from": "note_failed",
      "to": "end_recorded"
    }
  ]
}
