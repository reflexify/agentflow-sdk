            "kind": "template",
            "value": "{{ (input.cc or []) | join(', ') }}"
          },
          {
            "field": "autopilot",
            "kind": "literal",
            "value": "none"
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "unreadable",
      "name": "Attachments unreadable?",
      "node_type": "decision",
      "parameters": {
        "id": "unreadable",
        "label": "Attachments unreadable?",
        "branches": [
          {
            "edgeIds": [
              "e_unreadable"
            ],
            "when": {
              "==": [
                {
                  "var": "input.attachments_unreadable"
                },
                true
              ]
            }
          },
          {
            "edgeIds": [
              "e_readable"
            ],
            "default": true
          }
        ]
      },
      "settings": {}
    },
    {
      "id": "note_unreadable",
      "name": "Note: attachments lost",
      "node_type": "entity_record",
      "parameters": {
        "id": "note_unreadable",
        "label": "Note: attachments lost",
        "operation": "create",
        "entityId": "@obj:entity:note",
        "body": [
          {
            "field": "ticket",
            "kind": "reference",
            "value": "vars.ticket_id"
          },
          {
            "field": "kind",
            "kind": "literal",
            "value": "system"
          },
          {
            "field": "body",
            "kind": "literal",
            "value": "This email's attachments could not be read. Ask the customer to send them again."
          }
        ]
      },
      "settings": {}
    },
