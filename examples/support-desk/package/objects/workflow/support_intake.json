    {
      "id": "participant",
      "name": "Is the sender a participant?",
      "node_type": "code",
      "parameters": {
        "id": "participant",
        "label": "Is the sender a participant?",
        "language": "javascript",
        "source": "// Whether a matched message's sender may join the ticket's conversation: the\n// requester, or anyone an earlier accepted message was from, to or copied to.\n// Ticket numbers are guessable, so a match alone never admits a message.\n\nfunction lower(v) {\n  return typeof v === \"string\" ? v.trim().toLowerCase() : \"\";\n}\n\nfunction addresses(field) {\n  if (typeof field !== \"string\") return [];\n  return field\n    .split(/[,;]/)\n    .map((part) => {\n      const angled = part.match(/<([^>]+)>/);\n      return lower(angled ? angled[1] : part);\n    })\n    .filter((a) => a.includes(\"@\"));\n}\n\nfunction main(inputs) {\n  const ours = new Set(String(inputs.our_domains || \"\").split(\",\").map(lower).filter(Boolean));\n  const isOurs = (address) => ours.has(address.slice(address.lastIndexOf(\"@\") + 1));\n  const sender = lower(inputs.sender);\n\n  if (inputs.dmarc_failed === true) return { participant: false, reason: \"dmarc_failed\" };\n  if (isOurs(sender)) return { participant: false, reason: \"our_address\" };\n  if (sender !== \"\" && sender === lower(inputs.requester_email)) {\n    return { participant: true, reason: \"requester\" };\n  }\n  const known = new Set();\n  for (const r of Array.isArray(inputs.replies) ? inputs.replies : []) {\n    for (const a of [...addresses(r && r.from_address), ...addresses(r && r.to), ...addresses(r && r.cc)]) {\n      if (!isOurs(a)) known.add(a);\n    }\n  }\n  return known.has(sender)\n    ? { participant: true, reason: \"earlier_message\" }\n    : { participant: false, reason: \"not_a_participant\" };\n}\n",
        "inputs": [
          {
            "name": "sender",
            "kind": "reference",
            "value": "input.from_address"
          },
          {
            "name": "requester_email",
            "kind": "reference",
            "value": "nodes.requester.output.record.email"
          },
          {
            "name": "replies",
            "kind": "reference",
            "value": "nodes.accepted.output.records"
          },
          {
            "name": "our_domains",
            "kind": "literal",
            "value": "@param:our_domains"
          },
          {
            "name": "dmarc_failed",
            "kind": "reference",
            "value": "nodes.candidates.output.dmarc_failed"
          }
        ],
        "outputSchema": {
          "type": "object",
          "properties": {
            "participant": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "participant",
            "reason"
          ]
        },
        "timeoutSecs": 10
      },
      "settings": {}
    },
