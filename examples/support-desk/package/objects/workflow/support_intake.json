    {
      "id": "resolve",
      "name": "Pick the ticket",
      "node_type": "code",
      "parameters": {
        "id": "resolve",
        "label": "Pick the ticket",
        "language": "javascript",
        "source": "// Picks the ticket a message belongs to, by the strongest signal it carries:\n// a Message-ID it answers (ours, then the customer's own), then a ticket\n// number in the plus address, then one in the subject.\n\nconst OURS = new Set([\"agent\", \"bot\"]);\n\nfunction list(v) {\n  return Array.isArray(v) ? v : [];\n}\n\nfunction idOf(ref) {\n  if (typeof ref === \"string\") return ref;\n  return ref && typeof ref.id === \"string\" ? ref.id : null;\n}\n\nfunction main(inputs) {\n  const replies = list(inputs.replies);\n  for (const id of list(inputs.message_ids)) {\n    const reply = replies.find((r) => r && r.key === id);\n    const ticket = reply && idOf(reply.ticket);\n    if (ticket) {\n      return { ticket_id: ticket, signal: OURS.has(reply.author_kind) ? \"our_message\" : \"their_message\" };\n    }\n  }\n  const tickets = list(inputs.tickets);\n  for (const [numbers, signal] of [\n    [list(inputs.plus_numbers), \"plus_tag\"],\n    [list(inputs.subject_numbers), \"subject_token\"],\n  ]) {\n    for (const number of numbers) {\n      const ticket = tickets.find((t) => t && t.number === number);\n      if (ticket && idOf(ticket.id)) return { ticket_id: idOf(ticket.id), signal };\n    }\n  }\n  return { ticket_id: null, signal: null };\n}\n",
        "inputs": [
          {
            "name": "message_ids",
            "kind": "reference",
            "value": "nodes.candidates.output.message_ids"
          },
          {
            "name": "plus_numbers",
            "kind": "reference",
            "value": "nodes.candidates.output.plus_numbers"
          },
          {
            "name": "subject_numbers",
            "kind": "reference",
            "value": "nodes.candidates.output.subject_numbers"
          },
          {
            "name": "replies",
            "kind": "reference",
            "value": "nodes.by_message.output.records"
          },
          {
            "name": "tickets",
            "kind": "reference",
            "value": "nodes.by_number.output.records"
          }
        ],
        "outputSchema": {
          "type": "object",
          "properties": {
            "ticket_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "signal": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "ticket_id",
            "signal"
          ]
        },
        "timeoutSecs": 10
      },
      "settings": {}
    },
