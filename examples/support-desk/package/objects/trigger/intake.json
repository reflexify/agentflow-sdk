{
  "workflow": "@obj:workflow:support_intake",
  "kind": "connected_app",
  "enabled": false,
  "config": {
    "account": "@param:resend_connection_id",
    "object_type": "email.received",
    "change_kind": "created",
    "filter": {},
    "input_mappings": [
      {
        "from": "event.properties.message_id",
        "to": "message_id"
      },
      {
        "from": "event.properties.email_id",
        "to": "email_id"
      },
      {
        "from": "event.properties.in_reply_to",
        "to": "in_reply_to"
      },
      {
        "from": "event.properties.references",
        "to": "references"
      },
      {
        "from": "event.properties.plus_tags",
        "to": "plus_tags"
      },
      {
        "from": "event.properties.subject",
        "to": "subject"
      },
      {
        "from": "event.properties.from",
        "to": "from"
      },
      {
        "from": "event.properties.from_address",
        "to": "from_address"
      },
      {
        "from": "event.properties.to",
        "to": "to"
      },
      {
        "from": "event.properties.cc",
        "to": "cc"
      },
      {
        "from": "event.properties.text",
        "to": "text"
      },
      {
        "from": "event.properties.headers",
        "to": "headers"
      },
      {
        "from": "event.properties.attachments",
        "to": "attachments"
      },
      {
        "from": "event.properties.attachments_unreadable",
        "to": "attachments_unreadable"
      }
    ],
    "group": {
      "by": {
        "kind": "template",
        "template": "{{ event.properties.message_id or event.properties.email_id }}"
      }
    }
  }
}
