{
  "workflow": "@obj:workflow:support_handling",
  "kind": "entity_record",
  "enabled": false,
  "config": {
    "entity_id": "@obj:entity:ticket",
    "change_kind": "updated",
    "filter": {
      "or": [
        {
          "in": [
            "last_customer_at",
            {
              "var": "event.changed"
            }
          ]
        },
        {
          "in": [
            "priority",
            {
              "var": "event.changed"
            }
          ]
        },
        {
          "in": [
            "escalated_at",
            {
              "var": "event.changed"
            }
          ]
        }
      ]
    },
    "input_mappings": [],
    "group": {
      "by": {
        "kind": "record"
      },
      "linger_ms": 0,
      "max_batch": 50,
      "hold_while_waiting": true
    }
  }
}
