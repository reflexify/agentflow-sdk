{
  "formatVersion": 1,
  "id": "rfx/support-desk",
  "version": "1.0.0",
  "name": "Support desk",
  "summary": "A ticket app for a support team: customer email becomes tickets, AI drafts every reply, and people or autopilot send them.",
  "publisher": {
    "name": "Reflexify",
    "contact": "apps@reflexify.ai",
    "support": "https://reflexify.ai/support"
  },
  "license": "Proprietary",
  "dataHandling": {
    "purpose": "Answering customer email",
    "storage": "In the organization's AgentFlow",
    "retention": "As long as the organization keeps its tickets",
    "privacy": "https://reflexify.ai/privacy",
    "recipients": [
      "The organization's model provider",
      "Resend"
    ]
  },
  "changelog": "First packaged release.",
  "contentLocale": "en",
  "minPlatformVersion": "2026.10",
  "requires": {
    "platformCapabilities": [],
    "entities": [
      {
        "key": "user",
        "access": "read",
        "fields": {}
      },
      {
        "key": "org_unit",
        "access": "read",
        "fields": {}
      }
    ],
    "permissions": [
      {
        "group": "@param:support_group_id",
        "permissions": [
          "entity.read",
          "entity.list",
          "entity.write"
        ]
      },
      {
        "group": "@param:autopilot_admin_group_id",
        "permissions": [
          "entity.read",
          "entity.list",
          "entity.write"
        ]
      }
    ]
  },
  "exports": [],
  "parameters": [
    {
      "key": "support_group_id",
      "type": "group_ref",
      "required": true,
      "label": "Support group",
      "help": "The Support group, with the support team in it. It reads and writes the ticket app's records, and Send, Accept, Move and Draft reply start for its members. Give every member of it a role with entity.read, entity.list and entity.write: a role does not come from a group."
    },
    {
      "key": "autopilot_admin_group_id",
      "type": "group_ref",
      "required": true,
      "label": "Support admins group",
      "help": "The people who may switch an autopilot rule on or change its mode. Add them to the Support group as well, and give them the same role: the grant on Autopilot rule is what lets them write a rule."
    },
    {
      "key": "automation_principal_id",
      "type": "service_principal_ref",
      "required": true,
      "label": "Automation principal",
      "help": "The service principal the unattended workflows run as: Intake, Draft on customer message, Handling, the three Delivery workflows and Close idle tickets. Give it a role with entity.read, entity.list, entity.write and workflow.start.any, add it to the Support group, and issue it no credential: it never signs in."
    },
    {
      "key": "unit_low",
      "type": "unit_ref",
      "required": true,
      "label": "Low pool",
      "help": "The organizational unit whose people take low-priority tickets. Handling opens each ticket's task in the pool of its priority, so place each person in the units whose tickets they take."
    },
    {
      "key": "unit_normal",
      "type": "unit_ref",
      "required": true,
      "label": "Normal pool",
      "help": "The organizational unit whose people take normal-priority tickets. Handling opens each ticket's task in the pool of its priority, so place each person in the units whose tickets they take."
    },
    {
      "key": "unit_high",
      "type": "unit_ref",
      "required": true,
      "label": "High pool",
      "help": "The organizational unit whose people take high-priority tickets. Handling opens each ticket's task in the pool of its priority, so place each person in the units whose tickets they take."
    },
    {
      "key": "unit_urgent",
      "type": "unit_ref",
      "required": true,
      "label": "Urgent pool",
      "help": "The organizational unit whose people take urgent tickets. Handling opens each ticket's task in the pool of its priority, so place each person in the units whose tickets they take."
    },
    {
      "key": "resend_connection_id",
      "type": "connection_ref",
      "required": true,
      "label": "Resend connection",
      "help": "The Resend connection from Admin, Integrations: connected with a full-access API key (a sending-only key is refused), its sending domain verified and its inbound domain set. Intake reads mail through it and replies go out through it. Name it by its provider and its account, as a pair: {\"provider\": \"resend\", \"externalAccountId\": \"<the connection's account id>\"}. The Email steps and the triggers take that pair and refuse the connection's id on its own."
    },
    {
      "key": "inbound_domain",
      "type": "text",
      "required": true,
      "label": "Inbound domain",
      "help": "The connection's inbound (receiving) domain, for example support.example.com. Customers write to support@ that domain, and every reply names support+<ticket number>@ that domain as its Reply-To."
    },
    {
      "key": "our_domains",
      "type": "text",
      "required": true,
      "label": "Our domains",
      "help": "Every domain you send from or receive at, separated by commas. Intake leaves these addresses out when it checks who may write on a ticket."
    },
    {
      "key": "company_name",
      "type": "text",
      "required": true,
      "label": "Company name",
      "help": "The name in the line an automatic reply ends with when the autopilot rule's disclose is set: \"This reply was written by <company name>'s AI assistant.\""
    },
    {
      "key": "support_model",
      "type": "text",
      "required": true,
      "label": "Support model",
      "help": "The model that drafts every reply, as provider/model. Its provider must be configured on this deployment."
    },
    {
      "key": "triage_model",
      "type": "text",
      "required": true,
      "label": "Triage model",
      "help": "The model that labels each conversation's intent, confidence and sentiment for autopilot, as provider/model. Its provider must be configured on this deployment."
    },
    {
      "key": "timezone",
      "type": "text",
      "required": true,
      "label": "Timezone",
      "help": "An IANA name. Close idle tickets runs daily at 06:00 in it. This sets the hour that schedule fires and nothing else: the business calendar's zone, a separate setting, is the one that counts business days."
    }
  ],
