{
  "key": "reply",
  "name": "Reply",
  "description": "One message on a ticket: received, drafted or sent.",
  "icon": "mail",
  "accent": "indigo",
  "fields": [
    {
      "key": "ticket",
      "label": "Ticket",
      "type": "reference",
      "target_entity_id": "${entity:ticket}",
      "inverse_key": "replies",
      "inverse_label": "Replies"
    },
    {"key":"posted_at","label":"Posted","type":"datetime"},
    {
      "key": "author_kind",
      "label": "From",
      "type": "enum",
      "facetable": true,
      "enum_values": [
        {"value":"customer","label":"Customer"},
        {"value":"unverified","label":"Unverified sender","color":"amber"},
        {"value":"agent","label":"Agent"},
        {"value":"bot","label":"AI"}
      ]
    },
    {
      "key": "author_user",
      "label": "Sent by",
      "type": "reference",
      "target_entity_id": "ffffffff-0000-0000-0000-000000000001"
    },
    {
      "key": "status",
      "label": "Status",
      "type": "enum",
      "facetable": true,
      "enum_values": [
        {"value":"draft","label":"Draft"},
        {"value":"sending","label":"Sending"},
        {"value":"sent","label":"Sent"},
        {"value":"failed","label":"Failed","color":"rose"},
        {"value":"received","label":"Received"}
      ]
    },
    {"key":"body","label":"Message","type":"text","searchable":true},
    {"key":"attachments","label":"Attachments","type":"file","format_options":{"max_files":20}},
    {"key":"key","label":"Message key","type":"text"},
    {"key":"subject","label":"Subject","type":"text"},
    {"key":"in_reply_to","label":"In-Reply-To","type":"text"},
    {"key":"references","label":"References","type":"text"},
    {"key":"from_address","label":"From address","type":"text"},
    {"key":"to","label":"To","type":"text"},
    {"key":"cc","label":"Cc","type":"text"},
    {"key":"outbound_id","label":"Outbound id","type":"text"},
    {"key":"provider_id","label":"Provider id","type":"text"},
    {"key":"ai_body","label":"AI draft as written","type":"text"},
    {"key":"citations","label":"Sources","type":"text"},
    {
      "key": "autopilot",
      "label": "Autopilot",
      "type": "enum",
      "enum_values": [
        {"value":"none","label":"None"},
        {"value":"would_send","label":"Would have sent"},
        {"value":"sent","label":"Sent"}
      ],
      "default": {"kind":"literal","value":"none"}
    },
    {"key":"intent","label":"Intent","type":"text"},
    {
      "key": "intent_confidence",
      "label": "Intent confidence",
      "type": "number",
      "format_options": {"decimal_places":2}
    },
    {"key":"ai_unchanged","label":"Sent as the AI wrote it","type":"boolean"},
    {
      "key": "held_reason",
      "label": "Why it was held",
      "type": "enum",
      "enum_values": [
        {"value":"not_a_participant","label":"Not on the ticket"},
        {"value":"dmarc_failed","label":"Sender check failed"},
        {"value":"our_address","label":"From our own address"}
      ]
    },
    {
      "key": "matched_by",
      "label": "Matched by",
      "type": "enum",
      "enum_values": [
        {"value":"our_message","label":"A reply to our email"},
        {"value":"their_message","label":"A reply to their earlier message"},
        {"value":"plus_tag","label":"The reply address"},
        {"value":"subject_token","label":"The ticket number in the subject"}
      ]
    }
  ],
  "natural_key": [{"id":"key","name":"Message key","fields":["key"]}],
  "display_field": "subject",
  "views": [{"name":"All","key":"all"}],
  "create_form": {
    "name": "Reply",
    "schema": {
      "type": "object",
      "properties": {
        "ticket": {"type":"string","format":"entity","x-entity":"ticket","x-entityField":"ticket"},
        "posted_at": {"type":"string","format":"date-time","x-entityField":"posted_at"},
        "author_kind": {"type":"string","x-entityField":"author_kind"},
        "author_user": {"type":"string","format":"entity","x-entity":"user","x-entityField":"author_user"},
        "status": {"type":"string","x-entityField":"status"},
        "body": {"type":"string","x-entityField":"body"},
        "attachments": {"type":"array","items":{"type":"string","format":"attachment"},"x-entityField":"attachments"},
        "key": {"type":"string","x-entityField":"key"},
        "subject": {"type":"string","x-entityField":"subject"},
        "in_reply_to": {"type":"string","x-entityField":"in_reply_to"},
        "references": {"type":"string","x-entityField":"references"},
        "from_address": {"type":"string","x-entityField":"from_address"},
        "to": {"type":"string","x-entityField":"to"},
        "cc": {"type":"string","x-entityField":"cc"},
        "outbound_id": {"type":"string","x-entityField":"outbound_id"},
        "provider_id": {"type":"string","x-entityField":"provider_id"},
        "ai_body": {"type":"string","x-entityField":"ai_body"},
        "citations": {"type":"string","x-entityField":"citations"},
        "autopilot": {"type":"string","x-entityField":"autopilot"},
        "intent": {"type":"string","x-entityField":"intent"},
        "intent_confidence": {"type":"number","x-entityField":"intent_confidence"},
        "ai_unchanged": {"type":"boolean","x-entityField":"ai_unchanged"},
        "held_reason": {"type":"string","x-entityField":"held_reason"},
        "matched_by": {"type":"string","x-entityField":"matched_by"}
      }
    }
  },
  "access": {
    "mode": "restricted",
    "grants": [
      {
        "principal": {"kind":"group","id":"${param:support_group_id}"},
        "design": false,
        "operations": [
          {"operation":"read","scope":"organization"},
          {"operation":"list","scope":"organization"},
          {"operation":"create","scope":"organization"},
          {"operation":"update","scope":"organization"}
        ]
      }
    ]
  },
  "conversation": null
}
