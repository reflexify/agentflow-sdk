{
  "key": "ticket",
  "name": "Ticket",
  "description": "One customer issue and its conversation.",
  "icon": "ticket",
  "accent": "violet",
  "fields": [
    {
      "key": "number",
      "label": "Number",
      "type": "auto_number",
      "auto_number_scope": "ticket:{{ year() }}",
      "auto_number_format": "TK-{{ year() }}-{{ value | pad(4) }}"
    },
    {"key":"subject","label":"Subject","type":"text","searchable":true},
    {
      "key": "status",
      "label": "Status",
      "type": "enum",
      "facetable": true,
      "enum_values": [
        {"value":"new","label":"New","color":"sky"},
        {"value":"open","label":"Open","color":"amber"},
        {"value":"pending","label":"Pending","color":"gray"},
        {"value":"solved","label":"Solved","color":"emerald"},
        {"value":"closed","label":"Closed","color":"gray"}
      ],
      "default": {"kind":"literal","value":"new"}
    },
    {
      "key": "priority",
      "label": "Priority",
      "type": "enum",
      "facetable": true,
      "enum_values": [
        {"value":"low","label":"Low"},
        {"value":"normal","label":"Normal"},
        {"value":"high","label":"High","color":"amber"},
        {"value":"urgent","label":"Urgent","color":"rose"}
      ],
      "default": {"kind":"literal","value":"normal"}
    },
    {
      "key": "requester",
      "label": "Requester",
      "type": "reference",
      "target_entity_id": "${entity:contact}",
      "inverse_key": "tickets",
      "inverse_label": "Tickets"
    },
    {"key":"last_customer_at","label":"Customer last wrote","type":"datetime"},
    {
      "key": "answered_revision",
      "label": "Answered revision",
      "type": "number",
      "format_options": {"decimal_places":0}
    },
    {"key":"pending_since","label":"Pending since","type":"datetime"},
    {"key":"pending_token","label":"Pending token","type":"text","filterable":true},
    {"key":"first_replied_at","label":"First replied","type":"datetime"},
    {"key":"escalated_at","label":"Escalated","type":"datetime"},
    {
      "key": "possible_duplicate_of",
      "label": "Possible duplicate of",
      "type": "reference",
      "target_entity_id": "${entity:ticket}",
      "inverse_key": "possible_duplicates",
      "inverse_label": "Possible duplicates"
    },
    {"key":"summary","label":"Summary","type":"text"},
    {"key":"intent","label":"Intent","type":"text"}
  ],
  "natural_key": [],
  "display_field": "number",
  "views": [{"name":"All","key":"all"}],
  "create_form": {
    "name": "Ticket",
    "schema": {
      "type": "object",
      "properties": {
        "subject": {"type":"string","x-entityField":"subject"},
        "status": {"type":"string","x-entityField":"status"},
        "priority": {"type":"string","x-entityField":"priority"},
        "requester": {"type":"string","format":"entity","x-entity":"contact","x-entityField":"requester"},
        "last_customer_at": {"type":"string","format":"date-time","x-entityField":"last_customer_at"},
        "answered_revision": {"type":"number","x-entityField":"answered_revision"},
        "pending_since": {"type":"string","format":"date-time","x-entityField":"pending_since"},
        "pending_token": {"type":"string","x-entityField":"pending_token"},
        "first_replied_at": {"type":"string","format":"date-time","x-entityField":"first_replied_at"},
        "escalated_at": {"type":"string","format":"date-time","x-entityField":"escalated_at"},
        "possible_duplicate_of": {"type":"string","format":"entity","x-entity":"ticket","x-entityField":"possible_duplicate_of"},
        "summary": {"type":"string","x-entityField":"summary"},
        "intent": {"type":"string","x-entityField":"intent"}
      }
    }
  },
  "access": {
    "mode": "restricted",
    "grants": [
      {
        "principal": {"kind":"group","id":"${param:support_group_id}"},
        "design": false,
        "operations": [
          {"operation":"read","scope":"organization"},
          {"operation":"list","scope":"organization"},
          {"operation":"create","scope":"organization"},
          {"operation":"update","scope":"organization"}
        ]
      }
    ]
  },
  "conversation": {
    "messages": {"entity_id":"${entity:reply}","via":"ticket"},
    "order": "posted_at",
    "author": {
      "field": "author_kind",
      "speakers": {"customer":"user","unverified":"exclude","agent":"assistant","bot":"assistant"}
    },
    "body": "body",
    "attachments": "attachments",
    "status": {"field":"status","draft":"draft"},
    "key": "key"
  }
}
