{
  "formatVersion": 1,
  "id": "acme/task-page",
  "version": "0.1.0",
  "name": "Task page",
  "summary": "Send a request for review, and work the review task in the app's own screen instead of AgentFlow's task panel.",
  "publisher": {
    "name": "Acme",
    "contact": "apps@acme.example",
    "support": "https://acme.example/support"
  },
  "license": "Proprietary",
  "dataHandling": {
    "purpose": "Recording requests and the decision on each",
    "storage": "In the organization's AgentFlow",
    "retention": "As long as the organization keeps its requests",
    "privacy": "https://acme.example/privacy",
    "recipients": []
  },
  "changelog": "First release: the Request entity, a Send for review action and the Review a request workflow, whose Human step opens the app's review page.",
  "contentLocale": "en",
  "minPlatformVersion": "2027.02",
  "requires": {
    "platformCapabilities": [],
    "entities": [],
    "permissions": [
      {
        "group": "@param:app_users",
        "permissions": [
          "entity.read",
          "entity.list",
          "entity.write"
        ]
      }
    ]
  },
  "exports": [],
  "parameters": [
    {
      "key": "app_users",
      "type": "group_ref",
      "required": true,
      "label": "Request users",
      "help": "Everyone who sends requests and reviews them. Give its members a role with entity.read, entity.list and entity.write: a role does not come from a group."
    }
  ],
  "audience": "@param:app_users",
  "features": {},
  "objects": [
    {
      "key": "entity:request",
      "kind": "entity"
    },
    {
      "key": "entity_field:request/title",
      "kind": "entity_field"
    },
    {
      "key": "entity_field:request/status",
      "kind": "entity_field"
    },
    {
      "key": "entity_field:request/decision_note",
      "kind": "entity_field"
    },
    {
      "key": "entity_view:request/all",
      "kind": "entity_view"
    },
    {
      "key": "form:request",
      "kind": "form"
    },
    {
      "key": "workflow:review_request",
      "kind": "workflow"
    },
    {
      "key": "entity_action:request/send_for_review",
      "kind": "entity_action"
    }
  ],
  "grants": [
    {
      "key": "request_app_users",
      "to": "@param:app_users",
      "entity": "@obj:entity:request",
      "operations": {
        "read": "organization",
        "list": "organization",
        "create": "organization",
        "update": "organization"
      }
    },
    {
      "key": "start_review_request",
      "to": "@param:app_users",
      "workflow": "@obj:workflow:review_request"
    }
  ],
  "ceiling": {
    "narrow": {}
  },
  "egress": [],
  "ui": {
    "kind": "module",
    "entry": "ui/index.js",
    "contract": 5
  },
  "tests": []
}
