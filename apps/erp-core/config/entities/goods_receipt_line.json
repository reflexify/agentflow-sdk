{
  "key": "goods_receipt_line",
  "name": "Goods receipt line",
  "description": "A line of a goods receipt.",
  "fields": [
    {
      "key": "goods_receipt",
      "label": "Goods receipt",
      "type": "reference",
      "target_entity_id": "${entity:goods_receipt}",
      "on_target_delete": "cascade"
    },
    {
      "key": "erp_line_id",
      "label": "Line id in the ERP",
      "type": "text"
    },
    {
      "key": "line_no",
      "label": "Line number",
      "type": "number"
    },
    {
      "key": "po_line",
      "label": "Purchase order line",
      "type": "reference",
      "target_entity_id": "${entity:purchase_order_line}",
      "on_target_delete": "clear"
    },
    {
      "key": "item",
      "label": "Item",
      "type": "reference",
      "target_entity_id": "${entity:item}",
      "on_target_delete": "clear"
    },
    {
      "key": "description",
      "label": "Description",
      "type": "text",
      "searchable": true
    },
    {
      "key": "uom",
      "label": "Unit",
      "type": "text"
    },
    {
      "key": "qty",
      "label": "Quantity",
      "type": "number"
    },
    {
      "key": "qty_accepted",
      "label": "Quantity accepted",
      "type": "number"
    },
    {
      "key": "qty_rejected",
      "label": "Quantity rejected",
      "type": "number"
    }
  ],
  "natural_key": [],
  "display_field": "description",
  "views": [
    {
      "name": "All",
      "key": "all"
    }
  ],
  "access": {
    "mode": "restricted",
    "grants": [
      {
        "principal": {
          "kind": "group",
          "id": "${param:erp_readers}"
        },
        "design": false,
        "operations": [
          {
            "operation": "read",
            "scope": "organization"
          },
          {
            "operation": "list",
            "scope": "organization"
          }
        ]
      }
    ]
  }
}
