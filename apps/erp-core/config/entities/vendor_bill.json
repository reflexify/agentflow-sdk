{
  "key": "vendor_bill",
  "name": "Vendor bill",
  "description": "A vendor invoice or credit as the ERP holds it.",
  "fields": [
    {
      "key": "number",
      "label": "Number",
      "type": "text",
      "searchable": true
    },
    {
      "key": "kind",
      "label": "Kind",
      "type": "enum",
      "enum_values": [
        {
          "value": "invoice",
          "label": "Invoice"
        },
        {
          "value": "credit",
          "label": "Credit"
        }
      ]
    },
    {
      "key": "vendor",
      "label": "Vendor",
      "type": "reference",
      "target_entity_id": "${entity:vendor}",
      "on_target_delete": "clear"
    },
    {
      "key": "vendor_invoice_number",
      "label": "Vendor's invoice number",
      "type": "text",
      "searchable": true
    },
    {
      "key": "invoice_date",
      "label": "Invoice date",
      "type": "date"
    },
    {
      "key": "posting_date",
      "label": "Posting date",
      "type": "date"
    },
    {
      "key": "due_date",
      "label": "Due date",
      "type": "date"
    },
    {
      "key": "currency",
      "label": "Currency",
      "type": "text"
    },
    {
      "key": "exchange_rate",
      "label": "Exchange rate",
      "type": "number"
    },
    {
      "key": "prices_include_tax",
      "label": "Prices include tax",
      "type": "boolean"
    },
    {
      "key": "fiscal_scheme",
      "label": "Fiscal scheme",
      "type": "text"
    },
    {
      "key": "fiscal_template_no",
      "label": "Fiscal template number",
      "type": "text"
    },
    {
      "key": "fiscal_series",
      "label": "Fiscal series",
      "type": "text"
    },
    {
      "key": "fiscal_number",
      "label": "Fiscal number",
      "type": "text"
    },
    {
      "key": "fiscal_issuer_tax_code",
      "label": "Fiscal issuer tax code",
      "type": "text"
    },
    {
      "key": "amount_untaxed",
      "label": "Amount before tax",
      "type": "number"
    },
    {
      "key": "amount_tax",
      "label": "Tax",
      "type": "number"
    },
    {
      "key": "amount_total",
      "label": "Total",
      "type": "number"
    },
    {
      "key": "amount_due",
      "label": "Amount due",
      "type": "number"
    },
    {
      "key": "po_refs",
      "label": "Purchase orders",
      "type": "list",
      "item_fields": [
        {
          "key": "erp_id",
          "label": "Id in the ERP",
          "type": "text"
        },
        {
          "key": "number",
          "label": "Number",
          "type": "text"
        }
      ]
    },
    {
      "key": "external_ref",
      "label": "External reference",
      "type": "text"
    },
    {
      "key": "payment_status",
      "label": "Payment status",
      "type": "enum",
      "enum_values": [
        {
          "value": "unpaid",
          "label": "Unpaid"
        },
        {
          "value": "partial",
          "label": "Partial"
        },
        {
          "value": "paid",
          "label": "Paid"
        },
        {
          "value": "unknown",
          "label": "Unknown"
        }
      ]
    },
    {
      "key": "status",
      "label": "Status",
      "type": "enum",
      "enum_values": [
        {
          "value": "draft",
          "label": "Draft"
        },
        {
          "value": "pending_approval",
          "label": "Pending approval"
        },
        {
          "value": "parked",
          "label": "Parked"
        },
        {
          "value": "posted",
          "label": "Posted"
        },
        {
          "value": "cancelled",
          "label": "Cancelled"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
      "key": "raw_status",
      "label": "Status in the ERP",
      "type": "text"
    },
    {
      "key": "company",
      "label": "Company",
      "type": "reference",
      "target_entity_id": "${entity:company}",
      "on_target_delete": "clear"
    },
    {
      "key": "erp_id",
      "label": "Id in the ERP",
      "type": "text"
    },
    {
      "key": "changed_in_erp",
      "label": "Changed in the ERP",
      "type": "datetime"
    },
    {
      "key": "deleted_in_erp",
      "label": "Deleted in the ERP",
      "type": "boolean",
      "default": {
        "kind": "literal",
        "value": false
      }
    }
  ],
  "natural_key": [],
  "display_field": "number",
  "views": [
    {
      "name": "All",
      "key": "all"
    }
  ],
  "access": {
    "mode": "restricted",
    "grants": [
      {
        "principal": {
          "kind": "group",
          "id": "${param:erp_readers}"
        },
        "design": false,
        "operations": [
          {
            "operation": "read",
            "scope": "organization"
          },
          {
            "operation": "list",
            "scope": "organization"
          }
        ]
      }
    ]
  },
  "source": {
    "connection": "${param:erp}",
    "stream": "vendor_bill",
    "fields": {
      "number": {
        "from": "number"
      },
      "kind": {
        "from": "kind"
      },
      "vendor": {
        "ref": "${entity:vendor}",
        "key": [
          "company_erp_id",
          "vendor_erp_id"
        ]
      },
      "vendor_invoice_number": {
        "from": "vendor_invoice_number"
      },
      "invoice_date": {
        "from": "invoice_date"
      },
      "posting_date": {
        "from": "posting_date"
      },
      "due_date": {
        "from": "due_date"
      },
      "currency": {
        "from": "currency"
      },
      "exchange_rate": {
        "from": "exchange_rate"
      },
      "prices_include_tax": {
        "from": "prices_include_tax"
      },
      "fiscal_scheme": {
        "from": "fiscal_document.scheme"
      },
      "fiscal_template_no": {
        "from": "fiscal_document.template_no"
      },
      "fiscal_series": {
        "from": "fiscal_document.series"
      },
      "fiscal_number": {
        "from": "fiscal_document.number"
      },
      "fiscal_issuer_tax_code": {
        "from": "fiscal_document.issuer_tax_code"
      },
      "amount_untaxed": {
        "from": "amount_untaxed"
      },
      "amount_tax": {
        "from": "amount_tax"
      },
      "amount_total": {
        "from": "amount_total"
      },
      "amount_due": {
        "from": "amount_due"
      },
      "po_refs": {
        "from": "po_refs",
        "items": {
          "erp_id": {
            "from": "erp_id"
          },
          "number": {
            "from": "number"
          }
        }
      },
      "external_ref": {
        "from": "external_ref"
      },
      "payment_status": {
        "from": "payment_status"
      },
      "status": {
        "from": "status"
      },
      "raw_status": {
        "from": "raw_status"
      },
      "company": {
        "ref": "${entity:company}",
        "key": [
          "company_erp_id",
          "company_erp_id"
        ]
      },
      "erp_id": {
        "from": "erp_id"
      },
      "changed_in_erp": {
        "from": "source_changed_at"
      }
    },
    "lines": {
      "entity": "${entity:vendor_bill_line}",
      "from": "lines",
      "key": [
        "erp_line_id"
      ],
      "parent": "vendor_bill",
      "fields": {
        "erp_line_id": {
          "from": "erp_line_id"
        },
        "line_no": {
          "from": "line_no"
        },
        "kind": {
          "from": "kind"
        },
        "po_line": {
          "ref": "${entity:purchase_order_line}",
          "key": [
            "^company_erp_id",
            "po_line.erp_id"
          ],
          "line": [
            "po_line.line_erp_id"
          ]
        },
        "receipt_line": {
          "ref": "${entity:goods_receipt_line}",
          "key": [
            "^company_erp_id",
            "receipt_line.erp_id"
          ],
          "line": [
            "receipt_line.line_erp_id"
          ]
        },
        "item": {
          "ref": "${entity:item}",
          "key": [
            "^company_erp_id",
            "item_erp_id"
          ]
        },
        "account_erp_id": {
          "from": "account_erp_id"
        },
        "description": {
          "from": "description"
        },
        "uom": {
          "from": "uom"
        },
        "qty": {
          "from": "qty"
        },
        "unit_price": {
          "from": "unit_price"
        },
        "discount_percent": {
          "from": "discount_percent"
        },
        "taxes": {
          "from": "taxes",
          "items": {
            "tax_code_erp_id": {
              "from": "tax_code_erp_id"
            },
            "code": {
              "from": "code"
            },
            "rate": {
              "from": "rate"
            },
            "category": {
              "from": "category"
            },
            "amount": {
              "from": "amount"
            }
          }
        },
        "amount_untaxed": {
          "from": "amount_untaxed"
        },
        "dimensions": {
          "from": "dimensions",
          "items": {
            "dimension_erp_id": {
              "from": "dimension_erp_id"
            },
            "value_erp_id": {
              "from": "value_erp_id"
            }
          }
        }
      }
    },
    "on_delete": {
      "flag": "deleted_in_erp"
    }
  }
