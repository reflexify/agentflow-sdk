{
  "key": "purchase_order",
  "name": "Purchase order",
  "description": "A purchase order as the ERP holds it.",
  "fields": [
    {
      "key": "number",
      "label": "Number",
      "type": "text",
      "searchable": true
    },
    {
      "key": "vendor",
      "label": "Vendor",
      "type": "reference",
      "target_entity_id": "${entity:vendor}",
      "on_target_delete": "clear"
    },
    {
      "key": "vendor_ref",
      "label": "Vendor's reference",
      "type": "text"
    },
    {
      "key": "currency",
      "label": "Currency",
      "type": "text"
    },
    {
      "key": "exchange_rate",
      "label": "Exchange rate",
      "type": "number"
    },
    {
      "key": "order_date",
      "label": "Order date",
      "type": "date"
    },
    {
      "key": "expected_date",
      "label": "Expected date",
      "type": "date"
    },
    {
      "key": "buyer_email",
      "label": "Buyer's email",
      "type": "text"
    },
    {
      "key": "buyer_name",
      "label": "Buyer's name",
      "type": "text"
    },
    {
      "key": "prices_include_tax",
      "label": "Prices include tax",
      "type": "boolean"
    },
    {
      "key": "amount_untaxed",
      "label": "Amount before tax",
      "type": "number"
    },
    {
      "key": "amount_tax",
      "label": "Tax",
      "type": "number"
    },
    {
      "key": "amount_total",
      "label": "Total",
      "type": "number"
    },
    {
      "key": "receipt_state",
      "label": "Receipt progress",
      "type": "enum",
      "enum_values": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "partial",
          "label": "Partial"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "key": "billing_state",
      "label": "Billing progress",
      "type": "enum",
      "enum_values": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "partial",
          "label": "Partial"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ]
    },
    {
      "key": "status",
      "label": "Status",
      "type": "enum",
      "enum_values": [
        {
          "value": "draft",
          "label": "Draft"
        },
        {
          "value": "pending_approval",
          "label": "Pending approval"
        },
        {
          "value": "open",
          "label": "Open"
        },
        {
          "value": "closed",
          "label": "Closed"
        },
        {
          "value": "cancelled",
          "label": "Cancelled"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
      "key": "raw_status",
      "label": "Status in the ERP",
      "type": "text"
    },
    {
      "key": "company",
      "label": "Company",
      "type": "reference",
      "target_entity_id": "${entity:company}",
      "on_target_delete": "clear"
    },
    {
      "key": "erp_id",
      "label": "Id in the ERP",
      "type": "text"
    },
    {
      "key": "changed_in_erp",
      "label": "Changed in the ERP",
      "type": "datetime"
    },
    {
      "key": "deleted_in_erp",
      "label": "Deleted in the ERP",
      "type": "boolean",
      "default": {
        "kind": "literal",
        "value": false
      }
    }
  ],
  "natural_key": [],
  "display_field": "number",
  "views": [
    {
      "name": "All",
      "key": "all"
    }
  ],
  "access": {
    "mode": "restricted",
    "grants": [
      {
        "principal": {
          "kind": "group",
          "id": "${param:erp_readers}"
        },
        "design": false,
        "operations": [
          {
            "operation": "read",
            "scope": "organization"
          },
          {
            "operation": "list",
            "scope": "organization"
          }
        ]
      }
    ]
  },
  "source": {
    "connection": "${param:erp}",
    "stream": "purchase_order",
    "fields": {
      "number": {
        "from": "number"
      },
      "vendor": {
        "ref": "${entity:vendor}",
        "key": [
          "company_erp_id",
          "vendor_erp_id"
        ]
      },
      "vendor_ref": {
        "from": "vendor_ref"
      },
      "currency": {
        "from": "currency"
      },
      "exchange_rate": {
        "from": "exchange_rate"
      },
      "order_date": {
        "from": "order_date"
      },
      "expected_date": {
        "from": "expected_date"
      },
      "buyer_email": {
        "from": "buyer.email"
      },
      "buyer_name": {
        "from": "buyer.name"
      },
      "prices_include_tax": {
        "from": "prices_include_tax"
      },
      "amount_untaxed": {
        "from": "amount_untaxed"
      },
      "amount_tax": {
        "from": "amount_tax"
      },
      "amount_total": {
        "from": "amount_total"
      },
      "receipt_state": {
        "from": "receipt_state"
      },
      "billing_state": {
        "from": "billing_state"
      },
      "status": {
        "from": "status"
      },
      "raw_status": {
        "from": "raw_status"
      },
      "company": {
        "ref": "${entity:company}",
        "key": [
          "company_erp_id",
          "company_erp_id"
        ]
      },
      "erp_id": {
        "from": "erp_id"
      },
      "changed_in_erp": {
        "from": "source_changed_at"
      }
    },
    "lines": {
      "entity": "${entity:purchase_order_line}",
      "from": "lines",
      "key": [
        "erp_line_id"
      ],
      "parent": "purchase_order",
      "fields": {
        "erp_line_id": {
          "from": "erp_line_id"
        },
        "line_no": {
          "from": "line_no"
        },
        "kind": {
          "from": "kind"
        },
        "item": {
          "ref": "${entity:item}",
          "key": [
            "^company_erp_id",
            "item_erp_id"
          ]
        },
        "account_erp_id": {
          "from": "account_erp_id"
        },
        "description": {
          "from": "description"
        },
        "uom": {
          "from": "uom"
        },
        "qty_ordered": {
          "from": "qty_ordered"
        },
        "unit_price": {
          "from": "unit_price"
        },
        "discount_percent": {
          "from": "discount_percent"
        },
        "taxes": {
          "from": "taxes",
          "items": {
            "tax_code_erp_id": {
              "from": "tax_code_erp_id"
            },
            "code": {
              "from": "code"
            },
            "rate": {
              "from": "rate"
            },
            "category": {
              "from": "category"
            },
            "amount": {
              "from": "amount"
            }
          }
        },
        "amount_untaxed": {
          "from": "amount_untaxed"
        },
        "amount_total": {
          "from": "amount_total"
        },
        "qty_received": {
          "from": "qty_received"
        },
        "qty_billed_posted": {
          "from": "qty_billed_posted"
        },
        "qty_billed_draft": {
          "from": "qty_billed_draft"
        },
        "receipt_required": {
          "from": "receipt_required"
        },
        "receipt_line_matching": {
          "from": "receipt_line_matching"
        },
        "closed": {
          "from": "closed"
        },
        "dimensions": {
          "from": "dimensions",
          "items": {
            "dimension_erp_id": {
              "from": "dimension_erp_id"
            },
            "value_erp_id": {
              "from": "value_erp_id"
            }
          }
        }
      }
    },
    "on_delete": {
      "flag": "deleted_in_erp"
    }
  }
}
