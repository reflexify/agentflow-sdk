{
  "key": "item",
  "name": "Item",
  "description": "An item the ERP buys: stock, non-stock or a service.",
  "fields": [
    {
      "key": "code",
      "label": "Code",
      "type": "text",
      "searchable": true
    },
    {
      "key": "name",
      "label": "Name",
      "type": "text",
      "searchable": true
    },
    {
      "key": "kind",
      "label": "Kind",
      "type": "enum",
      "enum_values": [
        {
          "value": "stock",
          "label": "Stock"
        },
        {
          "value": "non_stock",
          "label": "Non stock"
        },
        {
          "value": "service",
          "label": "Service"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
      "key": "base_uom",
      "label": "Base unit",
      "type": "text"
    },
    {
      "key": "purchase_uom",
      "label": "Purchase unit",
      "type": "text"
    },
    {
      "key": "bill_control",
      "label": "Bill control",
      "type": "enum",
      "enum_values": [
        {
          "value": "ordered",
          "label": "Ordered"
        },
        {
          "value": "received",
          "label": "Received"
        }
      ]
    },
    {
      "key": "status",
      "label": "Status",
      "type": "enum",
      "enum_values": [
        {
          "value": "active",
          "label": "Active"
        },
        {
          "value": "inactive",
          "label": "Inactive"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
      "key": "raw_status",
      "label": "Status in the ERP",
      "type": "text"
    },
    {
      "key": "company",
      "label": "Company",
      "type": "reference",
      "target_entity_id": "${entity:company}",
      "on_target_delete": "clear"
    },
    {
      "key": "erp_id",
      "label": "Id in the ERP",
      "type": "text"
    },
    {
      "key": "changed_in_erp",
      "label": "Changed in the ERP",
      "type": "datetime"
    },
    {
      "key": "deleted_in_erp",
      "label": "Deleted in the ERP",
      "type": "boolean",
      "default": {
        "kind": "literal",
        "value": false
      }
    }
  ],
  "natural_key": [],
  "display_field": "name",
  "views": [
    {
      "name": "All",
      "key": "all"
    }
  ],
  "access": {
    "mode": "restricted",
    "grants": [
      {
        "principal": {
          "kind": "group",
          "id": "${param:erp_readers}"
        },
        "design": false,
        "operations": [
          {
            "operation": "read",
            "scope": "organization"
          },
          {
            "operation": "list",
            "scope": "organization"
          }
        ]
      }
    ]
  },
  "source": {
    "connection": "${param:erp}",
    "stream": "item",
    "fields": {
      "code": {
        "from": "code"
      },
      "name": {
        "from": "name"
      },
      "kind": {
        "from": "kind"
      },
      "base_uom": {
        "from": "base_uom"
      },
      "purchase_uom": {
        "from": "purchase_uom"
      },
      "bill_control": {
        "from": "bill_control"
      },
      "status": {
        "from": "status"
      },
      "raw_status": {
        "from": "raw_status"
      },
      "company": {
        "ref": "${entity:company}",
        "key": [
          "company_erp_id",
          "company_erp_id"
        ]
      },
      "erp_id": {
        "from": "erp_id"
      },
      "changed_in_erp": {
        "from": "source_changed_at"
      }
    },
    "on_delete": {
      "flag": "deleted_in_erp"
    }
  }
}
