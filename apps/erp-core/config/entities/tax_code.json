{
  "key": "tax_code",
  "name": "Tax code",
  "description": "A tax code of the ERP.",
  "fields": [
    {
      "key": "code",
      "label": "Code",
      "type": "text",
      "searchable": true
    },
    {
      "key": "name",
      "label": "Name",
      "type": "text",
      "searchable": true
    },
    {
      "key": "rate",
      "label": "Rate",
      "type": "number"
    },
    {
      "key": "category",
      "label": "Category",
      "type": "enum",
      "enum_values": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "reduced",
          "label": "Reduced"
        },
        {
          "value": "zero",
          "label": "Zero"
        },
        {
          "value": "exempt",
          "label": "Exempt"
        },
        {
          "value": "not_subject",
          "label": "Not subject"
        },
        {
          "value": "not_declared",
          "label": "Not declared"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
      "key": "direction",
      "label": "Direction",
      "type": "enum",
      "enum_values": [
        {
          "value": "purchase",
          "label": "Purchase"
        },
        {
          "value": "sale",
          "label": "Sale"
        },
        {
          "value": "both",
          "label": "Both"
        }
      ]
    },
    {
      "key": "prices_include_tax",
      "label": "Prices include tax",
      "type": "boolean"
    },
    {
      "key": "status",
      "label": "Status",
      "type": "enum",
      "enum_values": [
        {
          "value": "active",
          "label": "Active"
        },
        {
          "value": "inactive",
          "label": "Inactive"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
      "key": "raw_status",
      "label": "Status in the ERP",
      "type": "text"
    },
    {
      "key": "company",
      "label": "Company",
      "type": "reference",
      "target_entity_id": "${entity:company}",
      "on_target_delete": "clear"
    },
    {
      "key": "erp_id",
      "label": "Id in the ERP",
      "type": "text"
    },
    {
      "key": "changed_in_erp",
      "label": "Changed in the ERP",
      "type": "datetime"
    },
    {
      "key": "deleted_in_erp",
      "label": "Deleted in the ERP",
      "type": "boolean",
      "default": {
        "kind": "literal",
        "value": false
      }
    }
  ],
  "natural_key": [],
  "display_field": "name",
  "views": [
    {
      "name": "All",
      "key": "all"
    }
  ],
  "access": {
    "mode": "restricted",
    "grants": [
      {
        "principal": {
          "kind": "group",
          "id": "${param:erp_readers}"
        },
        "design": false,
        "operations": [
          {
            "operation": "read",
            "scope": "organization"
          },
          {
            "operation": "list",
            "scope": "organization"
          }
        ]
      }
    ]
  },
  "source": {
    "connection": "${param:erp}",
    "stream": "tax_code",
    "fields": {
      "code": {
        "from": "code"
      },
      "name": {
        "from": "name"
      },
      "rate": {
        "from": "rate"
      },
      "category": {
        "from": "category"
      },
      "direction": {
        "from": "direction"
      },
      "prices_include_tax": {
        "from": "prices_include_tax"
      },
      "status": {
        "from": "status"
      },
      "raw_status": {
        "from": "raw_status"
      },
      "company": {
        "ref": "${entity:company}",
        "key": [
          "company_erp_id",
          "company_erp_id"
        ]
      },
      "erp_id": {
        "from": "erp_id"
      },
      "changed_in_erp": {
        "from": "source_changed_at"
      }
    },
    "on_delete": {
      "flag": "deleted_in_erp"
    }
  }
}
